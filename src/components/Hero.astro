---
import Screenshot from "./Screenshot.astro";
import { defaultLang, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { getHome } from "../i18n/home";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const c = getHome(lang).hero;

const demoUrl = "https://app.chohle.ch";
const githubUrl = "https://github.com/chohle/chohle";
---

<section id="hero" class="relative isolate py-16 sm:py-24">
  <div class="mx-auto flex w-full max-w-2xl flex-col gap-12 px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
    <div class="flex flex-col items-center gap-6" data-reveal>
      <!-- terminal-prompt motif → links to the repo -->
      <a href={githubUrl} target="_blank" rel="noopener" class="group inline-flex max-w-full items-center gap-2.5 rounded-full bg-white/5 px-4 py-1.5 font-mono text-[0.8rem]/6 inset-ring-1 inset-ring-white/10 transition-colors hover:bg-white/10">
        <span class="text-accent-light" aria-hidden="true">$</span>
        <span class="truncate text-mauve-300">chohle <span class="text-mauve-500">new</span> --invoice</span>
        <span class="caret-blink ml-0.5 inline-block h-3.5 w-1.5 bg-accent-light align-middle motion-reduce:animate-none" aria-hidden="true"></span>
        <span class="ml-1 hidden border-l border-white/10 pl-2.5 text-mauve-400 transition-colors group-hover:text-white sm:inline">{t("badge.openSource")}</span>
      </a>

      <h1 set:html={c.headline} class="font-display max-w-5xl text-center text-[3.5rem]/[0.98] font-extrabold tracking-[-0.04em] text-balance text-white sm:text-[5.5rem]/[0.95]"></h1>

      <div class="flex max-w-3xl flex-col gap-4 text-center text-lg/8 text-mauve-400">
        <p>{c.sub}</p>
      </div>

      <div class="flex flex-col items-center gap-3 sm:flex-row">
        <a href={demoUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full bg-accent px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider text-mauve-950 hover:bg-accent-light">{t("cta.tryDemo")}</a>
        <a href={githubUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider text-white inset-ring-1 inset-ring-white/15 hover:bg-white/5">
          <svg class="inline-block size-4" viewBox="0 0 24 24" fill="currentColor" role="image"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
          {t("cta.viewOnGitHub")}
        </a>
      </div>
    </div>

    <!-- rig-style spec bar: hairline-divided monospace tags -->
    <div class="grid w-full grid-cols-2 border-t border-l border-white/10 sm:grid-cols-4" data-reveal>
      {["OPEN SOURCE", "SWISS QR-BILL", "SELF-HOSTABLE", "NO ACCOUNT"].map((spec) => (
        <div class="flex items-center justify-center gap-2 border-r border-b border-white/10 px-4 py-3 font-mono text-[0.7rem] tracking-[0.15em] text-mauve-400 uppercase">
          <span class="size-1.5 bg-accent-light" aria-hidden="true"></span>{spec}
        </div>
      ))}
    </div>

    <div class="w-full" data-reveal>
      <Screenshot class="rounded-lg" color="green" placement="bottom">
        <img src={`/screenshots/dashboard-${lang}.jpg`} alt="chohle dashboard" width="1456" height="1080" loading="eager" data-zoomable class="cursor-zoom-in bg-white" />
      </Screenshot>
    </div>
  </div>
</section>
