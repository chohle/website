---
import { docsNav } from "../lib/docs-nav";

interface Props {
  current: string;
}
const { current } = Astro.props;
---

<ul role="list" class="flex flex-col gap-8">
  {docsNav.map((group) => (
    <li>
      <h2 class="text-xs font-semibold text-mauve-950 dark:text-white">{group.title}</h2>
      <ul role="list" class="mt-3 flex flex-col border-l border-mauve-950/10 dark:border-white/10">
        {group.links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.href === current ? "page" : undefined}
              class={`-ml-px flex border-l py-1 pl-4 text-sm transition ${
                link.href === current
                  ? "border-mauve-950 font-medium text-mauve-950 dark:border-white dark:text-white"
                  : "border-transparent text-mauve-700 hover:border-mauve-950/30 hover:text-mauve-950 dark:text-mauve-400 dark:hover:text-white"
              }`}
            >
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ul>
