---
interface Props {
  width: number;
  height: number;
  x: number | string;
  y: number | string;
  squares?: [number, number][];
  class?: string;
}
const { width, height, x, y, squares, class: className } = Astro.props;
const id = "grid-" + crypto.randomUUID();
---

<svg aria-hidden="true" class={className}>
  <defs>
    <pattern id={id} width={width} height={height} patternUnits="userSpaceOnUse" x={x} y={y}>
      <path d={`M.5 ${height}V.5H${width}`} fill="none" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" stroke-width="0" fill={`url(#${id})`} />
  {squares && (
    <svg x={x} y={y} class="overflow-visible">
      {squares.map(([sx, sy]) => (
        <rect stroke-width="0" width={width + 1} height={height + 1} x={sx * width} y={sy * height} />
      ))}
    </svg>
  )}
</svg>
