---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { shot } from "../../lib/screenshots";
import { getLangFromUrl, localize } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const content = {
  en: {
    metaTitle: "chohle docs: Projects & pipeline",
    metaDescription:
      "Organize work into projects on a sales and purchasing pipeline, with budgets, rates, and the quotes, invoices and email attached.",
    h1: "Projects & pipeline",
    intro:
      "Group work into projects per client. Every project lives on a pipeline board, carries its own budget, and ties together the quotes, invoices and email that belong to it.",
    pipelineHeading: "The pipeline board",
    pipeline:
      "Projects move across stages on a drag-and-drop board. A project is either sales or purchasing: sales projects run from lead to contacted, proposal, won and active; purchasing projects run from need to requested, received and accepted, so your client work and your buying stay on separate boards.",
    ratesHeading: "Budgets & rates",
    rates:
      "Give a project a fixed-price or hourly budget so you can see what's at stake at a glance, and set per-customer rates and discounts so its quotes and invoices price themselves.",
    toInvoiceHeading: "Quotes, invoices & email in one place",
    toInvoiceBefore: "Everything a project touches lives with it, its quote, the ",
    toInvoiceLink: "invoices",
    toInvoiceAfter: " it bills, and the full email thread with the client, all reachable from the project.",
  },
  de: {
    metaTitle: "chohle Doku: Projekte & Pipeline",
    metaDescription:
      "Organisieren Sie Arbeit in Projekten auf einer Vertriebs- und Einkaufs-Pipeline, mit Budgets, Tarifen sowie verknüpften Offerten, Rechnungen und E-Mails.",
    h1: "Projekte & Pipeline",
    intro:
      "Fassen Sie Arbeit in Projekte pro Kunde zusammen. Jedes Projekt liegt auf einem Pipeline-Board, trägt sein eigenes Budget und verbindet die Offerten, Rechnungen und E-Mails, die dazugehören.",
    pipelineHeading: "Das Pipeline-Board",
    pipeline:
      "Projekte wandern über Stufen auf einem Drag-and-Drop-Board. Ein Projekt ist entweder Vertrieb oder Einkauf: Vertriebsprojekte laufen von Lead über kontaktiert, Offerte, gewonnen bis aktiv; Einkaufsprojekte laufen von Bedarf über angefragt, erhalten bis angenommen, so bleiben Kundenarbeit und Einkauf auf getrennten Boards.",
    ratesHeading: "Budgets & Tarife",
    rates:
      "Geben Sie einem Projekt ein Fixpreis- oder Stunden-Budget, damit Sie auf einen Blick sehen, worum es geht, und legen Sie kundenspezifische Ansätze und Rabatte fest, damit sich Offerten und Rechnungen von selbst bepreisen.",
    toInvoiceHeading: "Offerten, Rechnungen & E-Mail an einem Ort",
    toInvoiceBefore: "Alles, was ein Projekt berührt, liegt bei ihm, seine Offerte, die ",
    toInvoiceLink: "Rechnungen",
    toInvoiceAfter: ", die es abrechnet, und der gesamte E-Mail-Verlauf mit dem Kunden, alles vom Projekt aus erreichbar.",
  },
  fr: {
    metaTitle: "chohle docs: Projets & pipeline",
    metaDescription:
      "Organisez le travail en projets sur un pipeline de ventes et d'achats, avec budgets, tarifs et les devis, factures et e-mails rattachés.",
    h1: "Projets & pipeline",
    intro:
      "Regroupez le travail en projets par client. Chaque projet vit sur un tableau de pipeline, porte son propre budget et relie les devis, factures et e-mails qui lui appartiennent.",
    pipelineHeading: "Le tableau de pipeline",
    pipeline:
      "Les projets passent d'une étape à l'autre sur un tableau glisser-déposer. Un projet relève soit des ventes, soit des achats : les projets de vente vont du prospect au contacté, à la proposition, au gagné et à l'actif ; les projets d'achat vont du besoin au demandé, au reçu et à l'accepté, votre travail client et vos achats restent ainsi sur des tableaux distincts.",
    ratesHeading: "Budgets & tarifs",
    rates:
      "Attribuez à un projet un budget au forfait ou horaire pour voir l'enjeu d'un coup d'œil, et définissez des tarifs et remises par client pour que ses devis et factures se chiffrent d'eux-mêmes.",
    toInvoiceHeading: "Devis, factures & e-mail au même endroit",
    toInvoiceBefore: "Tout ce qu'un projet touche reste avec lui, son devis, les ",
    toInvoiceLink: "factures",
    toInvoiceAfter: " qu'il facture, et tout le fil d'e-mails avec le client, le tout accessible depuis le projet.",
  },
  it: {
    metaTitle: "chohle docs: Progetti & pipeline",
    metaDescription:
      "Organizza il lavoro in progetti su una pipeline di vendita e acquisti, con budget, tariffe e i preventivi, le fatture e le e-mail collegati.",
    h1: "Progetti & pipeline",
    intro:
      "Raggruppa il lavoro in progetti per cliente. Ogni progetto vive su una lavagna pipeline, porta il proprio budget e collega i preventivi, le fatture e le e-mail che gli appartengono.",
    pipelineHeading: "La lavagna pipeline",
    pipeline:
      "I progetti si spostano tra le fasi su una lavagna drag-and-drop. Un progetto è di vendita o di acquisto: i progetti di vendita vanno da opportunità a contattato, proposta, vinto e attivo; i progetti di acquisto vanno da necessità a richiesto, ricevuto e accettato, così il lavoro con i clienti e i tuoi acquisti restano su lavagne separate.",
    ratesHeading: "Budget & tariffe",
    rates:
      "Assegna a un progetto un budget a forfait o orario per vedere la posta in gioco a colpo d'occhio, e imposta tariffe e sconti per cliente così che i suoi preventivi e le sue fatture si prezzino da soli.",
    toInvoiceHeading: "Preventivi, fatture & e-mail in un unico posto",
    toInvoiceBefore: "Tutto ciò che un progetto tocca resta con esso, il suo preventivo, le ",
    toInvoiceLink: "fatture",
    toInvoiceAfter: " che fattura e l'intero scambio di e-mail con il cliente, il tutto raggiungibile dal progetto.",
  },
} as const;

const c = content[lang] ?? content.en;
---

<DocsLayout title={c.metaTitle} description={c.metaDescription}>
  <h1>{c.h1}</h1>
  <p>{c.intro}</p>

  <img
    src={shot("pipeline", lang)}
    alt={c.pipelineHeading}
    width="1456"
    height="1080"
    loading="lazy"
    class="my-8 w-full rounded-xl ring-1 ring-black/10 dark:ring-white/10"
  />

  <h2 id="pipeline">{c.pipelineHeading}</h2>
  <p>{c.pipeline}</p>

  <h2 id="rates">{c.ratesHeading}</h2>
  <p>{c.rates}</p>

  <h2 id="to-invoice">{c.toInvoiceHeading}</h2>
  <p>{c.toInvoiceBefore}<a href={localize("/docs/invoicing", lang)}>{c.toInvoiceLink}</a>{c.toInvoiceAfter}</p>

  <h2 id="project-page">{({ en: "The project page", de: "Die Projektseite", fr: "La page du projet", it: "La pagina del progetto" })[lang]}</h2>
  <p>{({
    en: "Open a project and its detail page is organised into tabs, overview, quotes, invoices and the conversation, so a busy project stays readable. The conversation tab is a chat-style thread: client emails and your replies sit in order like a messaging app, and you compose and send right from there.",
    de: "Öffnest du ein Projekt, ist seine Detailseite in Tabs gegliedert, Übersicht, Offerten, Rechnungen und die Konversation, sodass ein voller Projektverlauf lesbar bleibt. Der Konversations-Tab ist ein Chat-artiger Verlauf: Kunden-E-Mails und deine Antworten stehen wie in einer Messaging-App der Reihe nach, und du verfasst und sendest direkt von dort.",
    fr: "Ouvrez un projet et sa page de détail est organisée en onglets, aperçu, devis, factures et la conversation, pour qu'un projet chargé reste lisible. L'onglet conversation est un fil de style messagerie : les e-mails du client et vos réponses se suivent dans l'ordre comme une application de messagerie, et vous rédigez et envoyez directement depuis là.",
    it: "Apri un progetto e la sua pagina di dettaglio è organizzata in schede, panoramica, preventivi, fatture e la conversazione, così un progetto pieno resta leggibile. La scheda conversazione è un filo in stile chat: le e-mail del cliente e le tue risposte si susseguono in ordine come un'app di messaggistica, e componi e invii direttamente da lì.",
  })[lang]}</p>

  <img src={shot("project-detail", lang)} alt={({ en: "A project's detail page", de: "Die Detailseite eines Projekts", fr: "La page de détail d'un projet", it: "La pagina di dettaglio di un progetto" })[lang]} width="1456" height="1080" loading="lazy" class="my-8 w-full rounded-xl ring-1 ring-black/10 dark:ring-white/10" />

  <p>{({
    en: "Inbound email that does not thread to a project is caught in a review queue rather than dropped or misfiled. See ",
    de: "Eingehende E-Mail, die zu keinem Projekt threadet, wird in einer Prüf-Warteschlange aufgefangen, statt verworfen oder falsch abgelegt zu werden. Siehe ",
    fr: "Le courrier entrant qui ne se rattache à aucun projet est récupéré dans une file de vérification plutôt que supprimé ou mal classé. Voir ",
    it: "La posta in entrata che non si aggancia a un progetto viene raccolta in una coda di verifica invece di essere scartata o archiviata male. Vedi ",
  })[lang]}<a href={localize("/docs/triage", lang)}>Triage</a>.</p>

  <h2 id="organise">{({ en: "Labels, budgets and ordering", de: "Labels, Budgets und Reihenfolge", fr: "Étiquettes, budgets et ordre", it: "Etichette, budget e ordine" })[lang]}</h2>
  <p>{({
    en: "Each card shows a short label, its budget and a due date, and you drag cards to reorder them within a stage or move them along. A project can be fixed-price, hourly or just an estimate, whichever fits the work.",
    de: "Jede Karte zeigt ein kurzes Label, ihr Budget und ein Fälligkeitsdatum, und du ziehst Karten, um sie innerhalb einer Stufe neu zu ordnen oder weiterzuschieben. Ein Projekt kann Fixpreis, stundenbasiert oder nur eine Schätzung sein, je nachdem, was zur Arbeit passt.",
    fr: "Chaque carte affiche une courte étiquette, son budget et une échéance, et vous glissez les cartes pour les réordonner dans une étape ou les faire avancer. Un projet peut être au forfait, à l'heure ou une simple estimation, selon ce qui convient.",
    it: "Ogni scheda mostra una breve etichetta, il suo budget e una scadenza, e trascini le schede per riordinarle in una fase o farle avanzare. Un progetto può essere a forfait, a ore o solo una stima, a seconda di ciò che serve.",
  })[lang]}</p>
</DocsLayout>
