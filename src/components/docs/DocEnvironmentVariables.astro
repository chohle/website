---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const content = {
  en: {
    metaTitle: "chohle docs — Environment variables",
    metaDescription: "Every environment variable chohle reads, with defaults and descriptions.",
    h1: "Environment variables",
    introP1: "chohle is configured entirely through environment variables. Set them in a",
    introP2: "file or pass them to the container with",
    introP3: ".",
    referenceH2: "Reference",
    colVariable: "Variable",
    colDefault: "Default",
    colDescription: "Description",
    exampleH2: "Example",
    descs: [
      "Port chohle listens on.",
      "Public URL chohle is served from. Used in links and emails.",
      "Default currency for new invoices.",
      "Where chohle stores its data.",
      "Connection string for sending email.",
      "Random string used to sign sessions. Required in production.",
    ],
  },
  de: {
    metaTitle: "chohle Doku — Umgebungsvariablen",
    metaDescription: "Jede Umgebungsvariable, die chohle liest, mit Standardwerten und Beschreibungen.",
    h1: "Umgebungsvariablen",
    introP1: "chohle wird vollständig über Umgebungsvariablen konfiguriert. Setze sie in einer",
    introP2: "Datei oder übergib sie dem Container mit",
    introP3: ".",
    referenceH2: "Referenz",
    colVariable: "Variable",
    colDefault: "Standard",
    colDescription: "Beschreibung",
    exampleH2: "Beispiel",
    descs: [
      "Port, auf dem chohle lauscht.",
      "Öffentliche URL, unter der chohle ausgeliefert wird. Wird in Links und E-Mails verwendet.",
      "Standardwährung für neue Rechnungen.",
      "Wo chohle seine Daten speichert.",
      "Verbindungszeichenfolge für den E-Mail-Versand.",
      "Zufällige Zeichenfolge zum Signieren von Sessions. In der Produktion erforderlich.",
    ],
  },
  fr: {
    metaTitle: "Doc chohle — Variables d'environnement",
    metaDescription: "Toutes les variables d'environnement lues par chohle, avec valeurs par défaut et descriptions.",
    h1: "Variables d'environnement",
    introP1: "chohle se configure entièrement via des variables d'environnement. Définissez-les dans un fichier",
    introP2: "ou transmettez-les au conteneur avec",
    introP3: ".",
    referenceH2: "Référence",
    colVariable: "Variable",
    colDefault: "Valeur par défaut",
    colDescription: "Description",
    exampleH2: "Exemple",
    descs: [
      "Port sur lequel chohle écoute.",
      "URL publique depuis laquelle chohle est servi. Utilisée dans les liens et les e-mails.",
      "Devise par défaut pour les nouvelles factures.",
      "Emplacement où chohle stocke ses données.",
      "Chaîne de connexion pour l'envoi d'e-mails.",
      "Chaîne aléatoire utilisée pour signer les sessions. Requise en production.",
    ],
  },
  it: {
    metaTitle: "Documentazione chohle — Variabili d'ambiente",
    metaDescription: "Tutte le variabili d'ambiente lette da chohle, con valori predefiniti e descrizioni.",
    h1: "Variabili d'ambiente",
    introP1: "chohle è configurato interamente tramite variabili d'ambiente. Impostale in un file",
    introP2: "oppure passale al container con",
    introP3: ".",
    referenceH2: "Riferimento",
    colVariable: "Variabile",
    colDefault: "Predefinito",
    colDescription: "Descrizione",
    exampleH2: "Esempio",
    descs: [
      "Porta su cui chohle è in ascolto.",
      "URL pubblico da cui chohle viene servito. Usato nei link e nelle e-mail.",
      "Valuta predefinita per le nuove fatture.",
      "Dove chohle memorizza i suoi dati.",
      "Stringa di connessione per l'invio di e-mail.",
      "Stringa casuale usata per firmare le sessioni. Richiesta in produzione.",
    ],
  },
} as const;
const c = content[lang] ?? content.en;

const names = ["PORT", "BASE_URL", "BASE_CURRENCY", "DATABASE_URL", "SMTP_URL", "SECRET_KEY"];
const defaults = ["3000", "http://localhost:3000", "CHF", "file:/data/chohle.db", "—", "—"];
const vars = names.map((name, i) => ({ name, default: defaults[i], desc: c.descs[i] }));
---

<DocsLayout title={c.metaTitle} description={c.metaDescription}>
  <h1>{c.h1}</h1>
  <p>{c.introP1} <code>.env</code> {c.introP2} <code>--env-file</code>{c.introP3}</p>

  <h2 id="reference">{c.referenceH2}</h2>
  <div class="not-prose mt-6 overflow-x-auto rounded-2xl ring-1 ring-mauve-950/10 dark:ring-white/10">
    <table class="w-full border-collapse text-left text-sm/6">
      <thead>
        <tr class="border-b border-mauve-950/10 text-mauve-950 dark:border-white/10 dark:text-white">
          <th class="px-4 py-3 font-medium">{c.colVariable}</th>
          <th class="px-4 py-3 font-medium">{c.colDefault}</th>
          <th class="px-4 py-3 font-medium">{c.colDescription}</th>
        </tr>
      </thead>
      <tbody class="text-mauve-700 dark:text-mauve-400">
        {vars.map((v) => (
          <tr class="border-b border-mauve-950/5 last:border-0 dark:border-white/5">
            <td class="px-4 py-3 align-top"><code class="rounded bg-mauve-950/5 px-1.5 py-0.5 font-mono text-[0.85em] text-mauve-950 dark:bg-white/10 dark:text-white">{v.name}</code></td>
            <td class="px-4 py-3 align-top font-mono text-[0.85em]">{v.default}</td>
            <td class="px-4 py-3 align-top">{v.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="example">{c.exampleH2}</h2>
  <CodeBlock prompt={false} label=".env" code={`PORT=3000
BASE_URL=https://chohle.example.com
BASE_CURRENCY=CHF
SMTP_URL=smtp://user:pass@smtp.example.com:587
SECRET_KEY=change-me-to-a-long-random-string`} />
</DocsLayout>
