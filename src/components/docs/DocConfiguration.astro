---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { getLangFromUrl, localize } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const content = {
  en: {
    metaTitle: "chohle docs: Configuration",
    metaDescription: "Configure chohle with environment variables: owner login, session secret, email and data location.",
    h1: "Configuration",
    introA: "chohle is configured with environment variables. Copy",
    introB: "to",
    introC: "and adjust the values, then Docker Compose picks them up on the next start.",
    accountHeading: "Owner login and secrets",
    accountP: "On first launch chohle creates your owner account from these. Set a real password, and use long random strings for the two secrets.",
    a1: "your owner username and password.",
    a2: "seals the session cookie. 32 or more random characters.",
    a3: "encrypts the credentials of any mailbox you connect. 32 or more random characters.",
    emailHeading: "Sending email",
    emailA: "Set",
    emailB: "and",
    emailC: "to the mail server chohle should send invoices and reminders through. In development these point at the bundled Mailpit. See",
    emailLink: "Client email",
    emailEnd: "for connecting an inbox to read and reply.",
    dataHeading: "Where data lives",
    dataA: "By default chohle keeps its SQLite database and uploads under",
    dataB: ". Point",
    dataC: "somewhere else if you need to. See",
    dataLink: "Backups",
    dataEnd: "for keeping it safe.",
    fullRef: "See the full",
    fullRefLink: "environment variables",
    fullRefEnd: "reference for every option.",
  },
  de: {
    metaTitle: "chohle Doku: Konfiguration",
    metaDescription: "Konfiguriere chohle mit Umgebungsvariablen: Owner-Login, Session-Secret, E-Mail und Speicherort der Daten.",
    h1: "Konfiguration",
    introA: "chohle wird über Umgebungsvariablen konfiguriert. Kopiere",
    introB: "nach",
    introC: "und passe die Werte an. Docker Compose übernimmt sie beim nächsten Start.",
    accountHeading: "Owner-Login und Secrets",
    accountP: "Beim ersten Start legt chohle daraus dein Owner-Konto an. Setze ein echtes Passwort und verwende lange zufällige Zeichenfolgen für die beiden Secrets.",
    a1: "Benutzername und Passwort des Owners.",
    a2: "versiegelt das Session-Cookie. 32 oder mehr zufällige Zeichen.",
    a3: "verschlüsselt die Zugangsdaten jedes verbundenen Postfachs. 32 oder mehr zufällige Zeichen.",
    emailHeading: "E-Mail versenden",
    emailA: "Setze",
    emailB: "und",
    emailC: "auf den Mailserver, über den chohle Rechnungen und Mahnungen versenden soll. In der Entwicklung zeigen sie auf das mitgelieferte Mailpit. Siehe",
    emailLink: "Kunden-E-Mail",
    emailEnd: "zum Anbinden eines Postfachs zum Lesen und Antworten.",
    dataHeading: "Wo die Daten liegen",
    dataA: "Standardmässig hält chohle Datenbank und Uploads unter",
    dataB: ". Zeig",
    dataC: "bei Bedarf woanders hin. Siehe",
    dataLink: "Backups",
    dataEnd: "zum sicheren Aufbewahren.",
    fullRef: "Siehe die vollständige Referenz der",
    fullRefLink: "Umgebungsvariablen",
    fullRefEnd: "für jede Option.",
  },
  fr: {
    metaTitle: "Doc chohle: Configuration",
    metaDescription: "Configurez chohle avec des variables d'environnement : identifiant propriétaire, secret de session, e-mail et emplacement des données.",
    h1: "Configuration",
    introA: "chohle se configure avec des variables d'environnement. Copiez",
    introB: "vers",
    introC: "et ajustez les valeurs. Docker Compose les reprend au démarrage suivant.",
    accountHeading: "Identifiant propriétaire et secrets",
    accountP: "Au premier lancement, chohle crée votre compte propriétaire à partir de ces valeurs. Définissez un vrai mot de passe et utilisez de longues chaînes aléatoires pour les deux secrets.",
    a1: "votre nom d'utilisateur et mot de passe propriétaire.",
    a2: "scelle le cookie de session. 32 caractères aléatoires ou plus.",
    a3: "chiffre les identifiants de toute boîte que vous connectez. 32 caractères aléatoires ou plus.",
    emailHeading: "Envoi d'e-mails",
    emailA: "Définissez",
    emailB: "et",
    emailC: "sur le serveur de messagerie par lequel chohle doit envoyer factures et rappels. En développement, ils pointent vers le Mailpit intégré. Voir",
    emailLink: "E-mail client",
    emailEnd: "pour connecter une boîte afin de lire et répondre.",
    dataHeading: "Où vivent les données",
    dataA: "Par défaut, chohle conserve sa base SQLite et les fichiers sous",
    dataB: ". Pointez",
    dataC: "ailleurs si nécessaire. Voir",
    dataLink: "Sauvegardes",
    dataEnd: "pour les garder en sécurité.",
    fullRef: "Voir la référence complète des",
    fullRefLink: "variables d'environnement",
    fullRefEnd: "pour chaque option.",
  },
  it: {
    metaTitle: "Doc chohle: Configurazione",
    metaDescription: "Configura chohle con variabili d'ambiente: login del proprietario, segreto di sessione, e-mail e posizione dei dati.",
    h1: "Configurazione",
    introA: "chohle si configura con variabili d'ambiente. Copia",
    introB: "in",
    introC: "e regola i valori. Docker Compose li riprende al successivo avvio.",
    accountHeading: "Login del proprietario e segreti",
    accountP: "Al primo avvio chohle crea il tuo account proprietario da questi valori. Imposta una password vera e usa stringhe casuali lunghe per i due segreti.",
    a1: "nome utente e password del proprietario.",
    a2: "sigilla il cookie di sessione. 32 o più caratteri casuali.",
    a3: "cifra le credenziali di ogni casella che colleghi. 32 o più caratteri casuali.",
    emailHeading: "Invio delle e-mail",
    emailA: "Imposta",
    emailB: "e",
    emailC: "sul server di posta tramite cui chohle deve inviare fatture e solleciti. In sviluppo puntano al Mailpit integrato. Vedi",
    emailLink: "E-mail clienti",
    emailEnd: "per collegare una casella e leggere e rispondere.",
    dataHeading: "Dove vivono i dati",
    dataA: "Per impostazione predefinita chohle tiene il database SQLite e i file in",
    dataB: ". Punta",
    dataC: "altrove se necessario. Vedi",
    dataLink: "Backup",
    dataEnd: "per tenerli al sicuro.",
    fullRef: "Vedi il riferimento completo delle",
    fullRefLink: "variabili d'ambiente",
    fullRefEnd: "per ogni opzione.",
  },
} as const;
const c = content[lang] ?? content.en;
---

<DocsLayout title={c.metaTitle} description={c.metaDescription}>
  <h1>{c.h1}</h1>
  <p>{c.introA} <code>.env.example</code> {c.introB} <code>.env</code> {c.introC}</p>

  <h2 id="account">{c.accountHeading}</h2>
  <p>{c.accountP}</p>
  <ul>
    <li><code>NUXT_ADMIN_USERNAME</code> / <code>NUXT_ADMIN_PASSWORD</code>, {c.a1}</li>
    <li><code>NUXT_SESSION_PASSWORD</code>, {c.a2}</li>
    <li><code>CHOHLE_SECRET</code>, {c.a3}</li>
  </ul>

  <h2 id="email">{c.emailHeading}</h2>
  <p>{c.emailA} <code>NUXT_SMTP_HOST</code> {c.emailB} <code>NUXT_SMTP_PORT</code> {c.emailC} <a href={localize("/docs/email", lang)}>{c.emailLink}</a> {c.emailEnd}</p>

  <h2 id="data">{c.dataHeading}</h2>
  <p>{c.dataA} <code>data/</code>{c.dataB} <code>DATABASE_PATH</code> {c.dataC} <a href={localize("/docs/backups", lang)}>{c.dataLink}</a> {c.dataEnd}</p>

  <p>{c.fullRef} <a href={localize("/docs/environment-variables", lang)}>{c.fullRefLink}</a> {c.fullRefEnd}</p>
</DocsLayout>
