---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getLangFromUrl, localize } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const content = {
  en: {
    metaTitle: "chohle docs: Customers & articles",
    metaDescription: "Keep customers with their own rates and payment terms, and a library of reusable articles that price your quotes and invoices.",
    h1: "Customers & articles",
    intro:
      "Customers and articles are the building blocks every quote and invoice is made of. Set them up once and the rest of chohle fills itself in.",
    customersHeading: "Customers",
    customersText:
      "Store companies or individuals with their address, VAT/UID, contact, language, customer number, payment term and an optional discount and price category. Those defaults flow onto every document, and each customer's detail page gathers their projects, quotes and invoices in one place.",
    articlesHeading: "Reusable articles",
    articlesText:
      "Articles are saved line items, a name, unit, default price and MWST rate. Add one to a quote or invoice and the price, unit and tax fill in automatically. Articles can be global or tied to a specific customer for bespoke rates.",
    invoiceHeading: "Straight into a document",
    invoiceBefore: "From there it's a short hop to a ",
    invoiceLink: "quote",
    invoiceMid: " or an ",
    invoiceLink2: "invoice",
    invoiceAfter: ", pick the customer, drop in a few articles, and the totals, VAT and rounding are handled for you.",
  },
  de: {
    metaTitle: "chohle Doku: Kunden & Artikel",
    metaDescription: "Kunden mit eigenen Ansätzen und Zahlungsfristen führen, dazu eine Bibliothek wiederverwendbarer Artikel für Offerten und Rechnungen.",
    h1: "Kunden & Artikel",
    intro:
      "Kunden und Artikel sind die Bausteine jeder Offerte und Rechnung. Einmal eingerichtet, füllt sich der Rest von chohle von selbst.",
    customersHeading: "Kunden",
    customersText:
      "Erfasse Firmen oder Personen mit Adresse, MWST/UID, Kontakt, Sprache, Kundennummer, Zahlungsfrist sowie optionalem Rabatt und Preiskategorie. Diese Vorgaben fliessen auf jedes Dokument, und die Detailseite jedes Kunden bündelt dessen Projekte, Offerten und Rechnungen an einem Ort.",
    articlesHeading: "Wiederverwendbare Artikel",
    articlesText:
      "Artikel sind gespeicherte Positionen, Name, Einheit, Standardpreis und MWST-Satz. Füge einen zu einer Offerte oder Rechnung hinzu, und Preis, Einheit und Steuer werden automatisch eingesetzt. Artikel können global oder an einen bestimmten Kunden für massgeschneiderte Ansätze gebunden sein.",
    invoiceHeading: "Direkt in ein Dokument",
    invoiceBefore: "Von dort ist es nur ein kurzer Schritt zu einer ",
    invoiceLink: "Offerte",
    invoiceMid: " oder einer ",
    invoiceLink2: "Rechnung",
    invoiceAfter: ", Kunde wählen, ein paar Artikel einsetzen, und Summen, MWST und Rundung werden für dich erledigt.",
  },
  fr: {
    metaTitle: "chohle docs: Clients & articles",
    metaDescription: "Gérez vos clients avec leurs tarifs et délais de paiement, et une bibliothèque d'articles réutilisables qui chiffrent vos devis et factures.",
    h1: "Clients & articles",
    intro:
      "Les clients et les articles sont les briques de chaque devis et facture. Configurez-les une fois et le reste de chohle se remplit tout seul.",
    customersHeading: "Clients",
    customersText:
      "Enregistrez entreprises ou particuliers avec leur adresse, TVA/IDE, contact, langue, numéro de client, délai de paiement et une remise et catégorie de prix optionnelles. Ces valeurs par défaut se reportent sur chaque document, et la fiche de chaque client réunit ses projets, devis et factures au même endroit.",
    articlesHeading: "Articles réutilisables",
    articlesText:
      "Les articles sont des lignes enregistrées, un nom, une unité, un prix par défaut et un taux de TVA. Ajoutez-en un à un devis ou une facture et le prix, l'unité et la taxe se remplissent automatiquement. Les articles peuvent être globaux ou liés à un client précis pour des tarifs sur mesure.",
    invoiceHeading: "Directement dans un document",
    invoiceBefore: "De là, il n'y a qu'un pas vers un ",
    invoiceLink: "devis",
    invoiceMid: " ou une ",
    invoiceLink2: "facture",
    invoiceAfter: ", choisissez le client, ajoutez quelques articles, et les totaux, la TVA et l'arrondi sont gérés pour vous.",
  },
  it: {
    metaTitle: "chohle docs: Clienti & articoli",
    metaDescription: "Gestisci i clienti con tariffe e termini di pagamento propri e una libreria di articoli riutilizzabili che prezzano preventivi e fatture.",
    h1: "Clienti & articoli",
    intro:
      "Clienti e articoli sono i mattoni di ogni preventivo e fattura. Configurali una volta e il resto di chohle si compila da solo.",
    customersHeading: "Clienti",
    customersText:
      "Memorizza aziende o persone con indirizzo, IVA/IDI, contatto, lingua, numero cliente, termine di pagamento e uno sconto e categoria di prezzo opzionali. Questi valori predefiniti confluiscono su ogni documento, e la scheda di ogni cliente raccoglie i suoi progetti, preventivi e fatture in un unico posto.",
    articlesHeading: "Articoli riutilizzabili",
    articlesText:
      "Gli articoli sono voci salvate, un nome, un'unità, un prezzo predefinito e un'aliquota IVA. Aggiungine uno a un preventivo o a una fattura e prezzo, unità e imposta si compilano da soli. Gli articoli possono essere globali o legati a un cliente specifico per tariffe su misura.",
    invoiceHeading: "Dritti in un documento",
    invoiceBefore: "Da lì è un attimo arrivare a un ",
    invoiceLink: "preventivo",
    invoiceMid: " o a una ",
    invoiceLink2: "fattura",
    invoiceAfter: ", scegli il cliente, inserisci qualche articolo, e totali, IVA e arrotondamento sono gestiti per te.",
  },
} as const;

const c = content[lang] ?? content.en;
---

<DocsLayout title={c.metaTitle} description={c.metaDescription}>
  <h1>{c.h1}</h1>
  <p>{c.intro}</p>

  <img src={`/screenshots/customers-en.jpg`} alt={c.customersHeading} width="1456" height="1080" loading="lazy" class="my-8 w-full rounded-xl ring-1 ring-black/10 dark:ring-white/10" />

  <h2 id="customers">{c.customersHeading}</h2>
  <p>{c.customersText}</p>

  <h2 id="articles">{c.articlesHeading}</h2>
  <p>{c.articlesText}</p>

  <h2 id="to-document">{c.invoiceHeading}</h2>
  <p>{c.invoiceBefore}<a href={localize("/docs/quotes", lang)}>{c.invoiceLink}</a>{c.invoiceMid}<a href={localize("/docs/invoicing", lang)}>{c.invoiceLink2}</a>{c.invoiceAfter}</p>
  <h2 id="language-terms">{({ en: "Language and payment terms", de: "Sprache und Zahlungsfristen", fr: "Langue et délais de paiement", it: "Lingua e termini di pagamento" })[lang]}</h2>
  <p>{({
    en: "Each customer carries a language and a payment-term in days. The term sets the due date on their invoices automatically, and the language is there so a document can speak to the customer in theirs.",
    de: "Jeder Kunde trägt eine Sprache und eine Zahlungsfrist in Tagen. Die Frist setzt das Fälligkeitsdatum auf seinen Rechnungen automatisch, und die Sprache ist da, damit ein Dokument den Kunden in seiner Sprache anspricht.",
    fr: "Chaque client porte une langue et un délai de paiement en jours. Le délai fixe automatiquement l'échéance de ses factures, et la langue est là pour qu'un document s'adresse au client dans la sienne.",
    it: "Ogni cliente porta una lingua e un termine di pagamento in giorni. Il termine imposta automaticamente la scadenza sulle sue fatture, e la lingua è lì perché un documento possa parlare al cliente nella sua.",
  })[lang]}</p>
</DocsLayout>
