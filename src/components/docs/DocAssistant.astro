  { key: "signature", read: true, create: true, edit: true },
  { key: "expense", read: true, create: true, edit: false },
  { key: "income", read: false, create: true, edit: false },
];

const envNames = ["CHOHLE_ASSISTANT", "NUXT_LLM_BASE_URL", "NUXT_LLM_MODEL", "NUXT_LLM_API_KEY"];
const envDefaults = ["(off)", "http://ollama:11434/v1", "qwen2.5:7b", "(empty)"];
const vars = envNames.map((name, i) => ({ name, default: envDefaults[i], purpose: c.purposes[i] }));

const cell = (on: boolean) => (on ? "✓" : "");
---

<DocsLayout title={c.metaTitle} description={c.metaDescription}>
  <h1>{c.h1}</h1>
  <p>{c.intro}</p>

  <div class="not-prose my-6 flex gap-3 rounded-2xl bg-amber-50 p-4 text-sm/6 text-amber-900 ring-1 ring-amber-500/20 dark:bg-amber-400/10 dark:text-amber-200 dark:ring-amber-400/20">
    <svg class="mt-0.5 size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
    <p><strong class="font-semibold">{c.wipTitle}.</strong> {c.wipText}</p>
  </div>

  <img src={shot("assistant", lang)} alt={c.screenshotAlt} width="1456" height="1080" loading="lazy" class="my-8 w-full rounded-xl ring-1 ring-black/10 dark:ring-white/10" />

  <h2 id="what-it-can-do">{c.canH2}</h2>
  <p>{c.canRead}</p>
  <p>{c.canWrite}</p>

  <div class="not-prose mt-6 overflow-x-auto rounded-2xl ring-1 ring-mauve-950/10 dark:ring-white/10">
    <table class="w-full border-collapse text-left text-sm/6">
      <thead>
        <tr class="border-b border-mauve-950/10 text-mauve-950 dark:border-white/10 dark:text-white">
          <th class="px-4 py-3 font-medium">{c.matrixCols.entity}</th>
          <th class="px-4 py-3 text-center font-medium">{c.matrixCols.read}</th>
          <th class="px-4 py-3 text-center font-medium">{c.matrixCols.create}</th>
          <th class="px-4 py-3 text-center font-medium">{c.matrixCols.edit}</th>
        </tr>
      </thead>
      <tbody class="text-mauve-700 dark:text-mauve-400">
        {matrix.map((row) => (
          <tr class="border-b border-mauve-950/5 last:border-0 dark:border-white/5">
            <td class="px-4 py-3">{c.entityNames[row.key]}</td>
            <td class="px-4 py-3 text-center text-mauve-950 dark:text-white">{cell(row.read)}</td>
            <td class="px-4 py-3 text-center text-mauve-950 dark:text-white">{cell(row.create)}</td>
            <td class="px-4 py-3 text-center text-mauve-950 dark:text-white">{cell(row.edit)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>{c.matrixNote}</p>

  <h2 id="how-it-stays-safe">{c.safetyH2}</h2>
  <ul>
    {c.safetyItems.map((item) => (
      <li><strong>{item.t}:</strong> {item.d}</li>
    ))}
  </ul>

  <h2 id="turn-it-on">{c.enableH2}</h2>
  <p>{c.enableIntro}</p>

  <h3 id="option-a">{c.optionAH3}</h3>
  <p>{c.optionAText}</p>
  <CodeBlock prompt={false} label="bash" code={`docker compose --profile llm up
docker compose exec ollama ollama pull qwen2.5:7b`} />
  <p>{c.optionAEnvText}</p>
  <CodeBlock prompt={false} label=".env" code={`CHOHLE_ASSISTANT=true
NUXT_LLM_BASE_URL=http://ollama:11434/v1
NUXT_LLM_MODEL=qwen2.5:7b`} />

  <h3 id="option-b">{c.optionBH3}</h3>
  <p>{c.optionBText}</p>
  <CodeBlock prompt={false} label=".env" code={`CHOHLE_ASSISTANT=true
NUXT_LLM_BASE_URL=http://your-endpoint:1234/v1
NUXT_LLM_MODEL=your-model
NUXT_LLM_API_KEY=your-key-if-needed`} />

  <h2 id="configuration">{c.configH2}</h2>
  <div class="not-prose mt-6 overflow-x-auto rounded-2xl ring-1 ring-mauve-950/10 dark:ring-white/10">
    <table class="w-full border-collapse text-left text-sm/6">
      <thead>
        <tr class="border-b border-mauve-950/10 text-mauve-950 dark:border-white/10 dark:text-white">
          <th class="px-4 py-3 font-medium">{c.configCols.variable}</th>
          <th class="px-4 py-3 font-medium">{c.configCols.default}</th>
          <th class="px-4 py-3 font-medium">{c.configCols.purpose}</th>
        </tr>
      </thead>
      <tbody class="text-mauve-700 dark:text-mauve-400">
        {vars.map((v) => (
          <tr class="border-b border-mauve-950/5 last:border-0 dark:border-white/5">
            <td class="px-4 py-3 align-top"><code class="rounded bg-mauve-950/5 px-1.5 py-0.5 font-mono text-[0.85em] text-mauve-950 dark:bg-white/10 dark:text-white">{v.name}</code></td>
            <td class="px-4 py-3 align-top font-mono text-[0.85em]">{v.default}</td>
            <td class="px-4 py-3 align-top">{v.purpose}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="choosing-a-model">{c.modelH2}</h2>
  <p>{c.modelText}</p>
  <ul>
    {c.models.map((m) => (
      <li><strong>{m.n}:</strong> {m.d}</li>
    ))}
  </ul>
  <p>{c.hardwareNote}</p>

  <h2 id="give-it-a-try">{c.tryH2}</h2>
  <p>{c.tryText}</p>
  <ul>
    {c.tryExamples.map((ex) => (
      <li><em>{ex}</em></li>
    ))}
  </ul>

  <h2 id="related">{c.moreH2}</h2>
  <p>
    {c.moreText} <a href={localize("/docs/environment-variables", lang)}>{c.moreLinkEnv}</a> {c.moreAnd}
    <a href={localize("/docs/self-hosting", lang)}>{c.moreLinkHost}</a> {c.moreEnd}
  </p>
</DocsLayout>
