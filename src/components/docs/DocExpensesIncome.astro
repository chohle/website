---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const content = {
  en: {
    metaTitle: "chohle docs: Expenses & income",
    metaDescription: "Track expenses with receipts and categories, and record income with automatic Swiss pay-date calculation.",
    h1: "Expenses & income",
    intro:
      "Beyond billing, chohle keeps the other half of your books: what you spend and what lands in your account. Both feed the dashboard's month-at-a-glance and the income-versus-expenses trend.",
    expensesHeading: "Expenses with receipts",
    expensesText:
      "Log an expense with its amount, date, vendor and category, and attach the receipt as a PDF or image. Filter by category or month, and the totals roll straight into your dashboard so you always know where the money went.",
    incomeHeading: "Income & Swiss pay dates",
    incomeText:
      "Record salary and client income as recurring sources. chohle calculates the actual pay date the Swiss way, shifting around weekends and cantonal public holidays, so “expected this month” reflects when the money really lands, not just the nominal payout day.",
    categoriesHeading: "Categories",
    categoriesText:
      "Categories give every expense and income a colour and an icon, and power the breakdowns on the dashboard. They're yours to rename, recolour and reorganise as your business changes.",
  },
  de: {
    metaTitle: "chohle Doku: Ausgaben & Einnahmen",
    metaDescription: "Ausgaben mit Belegen und Kategorien erfassen und Einnahmen mit automatischer Schweizer Zahltagsberechnung verbuchen.",
    h1: "Ausgaben & Einnahmen",
    intro:
      "Über die Rechnungsstellung hinaus führt chohle die andere Hälfte deiner Buchhaltung: was du ausgibst und was auf deinem Konto landet. Beides speist den Monatsüberblick im Dashboard und den Trend Einnahmen gegen Ausgaben.",
    expensesHeading: "Ausgaben mit Belegen",
    expensesText:
      "Erfasse eine Ausgabe mit Betrag, Datum, Lieferant und Kategorie und häng den Beleg als PDF oder Bild an. Filtere nach Kategorie oder Monat, die Summen fliessen direkt ins Dashboard, sodass du immer weisst, wohin das Geld ging.",
    incomeHeading: "Einnahmen & Schweizer Zahltage",
    incomeText:
      "Erfasse Lohn und Kundeneinnahmen als wiederkehrende Quellen. chohle berechnet das tatsächliche Zahldatum nach Schweizer Art, verschoben um Wochenenden und kantonale Feiertage, sodass „erwartet diesen Monat“ widerspiegelt, wann das Geld wirklich kommt, nicht nur den nominalen Auszahlungstag.",
    categoriesHeading: "Kategorien",
    categoriesText:
      "Kategorien geben jeder Ausgabe und Einnahme eine Farbe und ein Icon und treiben die Auswertungen im Dashboard an. Du kannst sie umbenennen, umfärben und neu ordnen, wie sich dein Geschäft entwickelt.",
  },
  fr: {
    metaTitle: "chohle docs: Dépenses & revenus",
    metaDescription: "Suivez les dépenses avec justificatifs et catégories, et enregistrez les revenus avec calcul automatique de la date de paie suisse.",
    h1: "Dépenses & revenus",
    intro:
      "Au-delà de la facturation, chohle tient l'autre moitié de votre comptabilité : ce que vous dépensez et ce qui arrive sur votre compte. Les deux alimentent l'aperçu du mois du tableau de bord et la tendance revenus contre dépenses.",
    expensesHeading: "Dépenses avec justificatifs",
    expensesText:
      "Enregistrez une dépense avec son montant, sa date, son fournisseur et sa catégorie, et joignez le justificatif en PDF ou en image. Filtrez par catégorie ou par mois, les totaux remontent directement dans votre tableau de bord, pour toujours savoir où est passé l'argent.",
    incomeHeading: "Revenus & dates de paie suisses",
    incomeText:
      "Enregistrez salaire et revenus clients comme sources récurrentes. chohle calcule la date de paiement réelle à la suisse, en tenant compte des week-ends et des jours fériés cantonaux, pour que « attendu ce mois-ci » reflète quand l'argent arrive vraiment, pas seulement le jour de versement nominal.",
    categoriesHeading: "Catégories",
    categoriesText:
      "Les catégories donnent à chaque dépense et revenu une couleur et une icône, et alimentent les répartitions du tableau de bord. À vous de les renommer, recolorer et réorganiser au fil de l'évolution de votre activité.",
  },
  it: {
    metaTitle: "chohle docs: Uscite & entrate",
    metaDescription: "Registra le uscite con ricevute e categorie e le entrate con calcolo automatico della data di paga svizzera.",
    h1: "Uscite & entrate",
    intro:
      "Oltre alla fatturazione, chohle tiene l'altra metà della tua contabilità: quello che spendi e quello che arriva sul tuo conto. Entrambi alimentano il riepilogo del mese nella dashboard e l'andamento entrate contro uscite.",
    expensesHeading: "Uscite con ricevute",
    expensesText:
      "Registra un'uscita con importo, data, fornitore e categoria, e allega la ricevuta come PDF o immagine. Filtra per categoria o mese, i totali confluiscono direttamente nella dashboard, così sai sempre dove sono andati i soldi.",
    incomeHeading: "Entrate & date di paga svizzere",
    incomeText:
      "Registra stipendio ed entrate dei clienti come fonti ricorrenti. chohle calcola la data di pagamento effettiva all'uso svizzero, spostandola attorno a fine settimana e festività cantonali, così « previsto questo mese » riflette quando i soldi arrivano davvero, non solo il giorno di pagamento nominale.",
    categoriesHeading: "Categorie",
    categoriesText:
      "Le categorie danno a ogni uscita ed entrata un colore e un'icona e alimentano le suddivisioni nella dashboard. Sta a te rinominarle, ricolorarle e riorganizzarle man mano che la tua attività cambia.",
  },
} as const;

const c = content[lang] ?? content.en;
---

<DocsLayout title={c.metaTitle} description={c.metaDescription}>
  <h1>{c.h1}</h1>
  <p>{c.intro}</p>

  <img src={`/screenshots/expenses-en.jpg`} alt={c.expensesHeading} width="1456" height="1080" loading="lazy" class="my-8 w-full rounded-xl ring-1 ring-black/10 dark:ring-white/10" />

  <h2 id="expenses">{c.expensesHeading}</h2>
  <p>{c.expensesText}</p>

  <h2 id="income">{c.incomeHeading}</h2>
  <p>{c.incomeText}</p>

  <img src={`/screenshots/income-en.jpg`} alt={c.incomeHeading} width="1456" height="1080" loading="lazy" class="my-8 w-full rounded-xl ring-1 ring-black/10 dark:ring-white/10" />

  <h2 id="categories">{c.categoriesHeading}</h2>
  <p>{c.categoriesText}</p>

  <img src={`/screenshots/categories-en.jpg`} alt={c.categoriesHeading} width="1456" height="1080" loading="lazy" class="my-8 w-full rounded-xl ring-1 ring-black/10 dark:ring-white/10" />
  <h2 id="filters">{({ en: "Filters and where the numbers go", de: "Filter und wohin die Zahlen fliessen", fr: "Filtres et où vont les chiffres", it: "Filtri e dove vanno i numeri" })[lang]}</h2>
  <p>{({
    en: "Filter expenses by category or by month to find anything fast. Whatever you record flows straight into the dashboard's month-at-a-glance and the Payments ledger, so the books stay in sync without extra steps.",
    de: "Filtere Ausgaben nach Kategorie oder Monat, um alles schnell zu finden. Was du erfasst, fliesst direkt in den Monatsüberblick des Dashboards und in das Zahlungs-Verzeichnis, sodass die Buchhaltung ohne Zusatzschritte stimmig bleibt.",
    fr: "Filtrez les dépenses par catégorie ou par mois pour tout retrouver vite. Ce que vous enregistrez alimente directement l'aperçu du mois du tableau de bord et le registre des Paiements, pour que la comptabilité reste à jour sans étape de plus.",
    it: "Filtra le uscite per categoria o per mese per trovare tutto in fretta. Ciò che registri confluisce direttamente nel riepilogo del mese della dashboard e nel registro dei Pagamenti, così i conti restano allineati senza passaggi in più.",
  })[lang]}</p>
</DocsLayout>
