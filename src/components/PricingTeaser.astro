---
import { defaultLang, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { localize } from "../i18n/utils";
import { getHome } from "../i18n/home";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const c = getHome(lang).pricing;
---

<section id="pricing" class="py-16">
  <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
    <div class="flex flex-col gap-6">
      <div class="flex max-w-4xl flex-col gap-2">
        <h2 class="font-display text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">{c.headline}</h2>
      </div>
      <div class="flex max-w-3xl flex-col gap-4 text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">
        <p>{c.body}</p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <a href={localize("/pricing", lang)} class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm/7 font-medium bg-mauve-950 text-white hover:bg-mauve-800 dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">
        {t("cta.seePricing")}
        <svg class="inline-block" width="13" height="7" viewBox="0 0 13 7" fill="none" stroke-width="1" role="image"><path d="M12.5049 3.49512L0.504883 3.49512" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /><path d="M9.5 6.5L12.5 3.5L9.5 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>
</section>
