---
import { defaultLang, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { localize } from "../i18n/utils";
import { getHome } from "../i18n/home";
import Eyebrow from "./Eyebrow.astro";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const c = getHome(lang).pricing;
---

<section id="pricing" class="py-16 sm:py-24">
  <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
    <div class="shape flex flex-col gap-8 bg-mauve-50 p-8 sm:p-12 lg:flex-row lg:items-center lg:justify-between lg:gap-12 dark:bg-white/5" data-reveal>
      <div class="flex max-w-2xl flex-col gap-3">
        <Eyebrow>{t("nav.pricing")}</Eyebrow>
        <h2 class="font-display text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">{c.headline}</h2>
        <p class="text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">{c.body}</p>
      </div>
      <a href={localize("/pricing", lang)} class="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-full px-5 py-2.5 text-sm/7 font-medium btn-ink bg-mauve-950 text-white lg:self-auto dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">
        {t("cta.seePricing")}
        <svg class="inline-block" width="13" height="7" viewBox="0 0 13 7" fill="none" stroke-width="1" role="image"><path d="M12.5049 3.49512L0.504883 3.49512" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /><path d="M9.5 6.5L12.5 3.5L9.5 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>
</section>
