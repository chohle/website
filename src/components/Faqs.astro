---
import { defaultLang, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { localize } from "../i18n/utils";
import { getHome } from "../i18n/home";
import Accordion from "./Accordion.astro";
import Eyebrow from "./Eyebrow.astro";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const c = getHome(lang);
const docsUrl = localize("/docs", lang);
---

<section id="faqs" class="py-16 sm:py-24">
  <div class="mx-auto grid w-full max-w-2xl grid-cols-1 gap-x-16 gap-y-10 px-6 md:max-w-3xl lg:max-w-7xl lg:grid-cols-[minmax(0,1fr)_1.4fr] lg:px-10">
    <div class="flex flex-col gap-6 lg:sticky lg:top-28 lg:self-start" data-reveal>
      <div class="flex flex-col gap-3">
        <Eyebrow>{t("eyebrow.faq")}</Eyebrow>
        <h2 class="font-display text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">{c.faqsTitle}</h2>
      </div>
      <p class="max-w-md text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">{c.faqsSub}</p>
      <div class="mt-2 flex flex-col gap-1">
        <span class="text-sm/7 font-medium text-mauve-950 dark:text-white">{t("faqs.more")}</span>
        <a href={docsUrl} target="_blank" rel="noopener" class="group inline-flex w-fit items-center gap-2 link-line text-sm/7 font-medium text-mauve-600 transition-colors hover:text-mauve-950">
          {t("cta.readDocs")}
          <svg class="inline-block transition-transform group-hover:translate-x-0.5" width="13" height="7" viewBox="0 0 13 7" fill="none" stroke-width="1" role="image"><path d="M12.5049 3.49512L0.504883 3.49512" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /><path d="M9.5 6.5L12.5 3.5L9.5 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>

    <Accordion items={c.faqs} idPrefix="home-faq" />
  </div>
</section>
