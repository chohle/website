---
import { defaultLang, type Lang } from "../i18n/config";
import { localize } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";
import Logo from "./Logo.astro";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const githubUrl = "https://github.com/chohle/chohle";

const year = new Date().getFullYear();
---

<footer id="footer" class="pt-16">
  <div class="border-t border-mauve-950/10 bg-white text-mauve-950">
    <div class="mx-auto w-full max-w-2xl px-6 pt-8 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex items-center justify-between gap-6">
        <p class="text-sm/6 text-mauve-600 dark:text-mauve-500">© {year} chohle</p>
        <div class="flex items-center gap-6">
          <a href={githubUrl} target="_blank" rel="noopener" class="link-line text-sm/6 text-mauve-600 transition-colors hover:text-mauve-950">GitHub</a>
          <a href={localize("/privacy", lang)} class="link-line text-sm/6 text-mauve-600 transition-colors hover:text-mauve-950">{t("label.privacy")}</a>
        </div>
      </div>
    </div>

    <div class="mt-8 overflow-hidden px-6 lg:px-10" aria-hidden="true">
      <Logo class="block w-full h-auto -mb-[5%] text-mauve-950" />
    </div>
  </div>
</footer>
