---
import { defaultLang, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const demoUrl = "https://app.chohle.ch";
const githubUrl = "https://github.com/chohle/chohle";
---

<section id="call-to-action" class="py-16 sm:py-24">
  <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
    <div class="relative isolate overflow-hidden bg-accent px-6 py-20 sm:px-16 sm:py-28" data-reveal>
      <div class="relative mx-auto flex max-w-3xl flex-col items-center gap-8 text-center">
        <span class="inline-flex items-center gap-1.5 font-mono text-[0.7rem]/6 font-medium tracking-[0.25em] text-mauve-950/70 uppercase">
          <span aria-hidden="true">[</span>{t("cta.tryDemo")}<span aria-hidden="true">]</span>
        </span>
        <h2 class="font-display text-[2.75rem]/[0.95] font-extrabold tracking-[-0.03em] text-balance text-mauve-950 sm:text-6xl/[0.95]">{t("cta.title")}</h2>
        <p class="max-w-xl text-base/7 text-pretty text-mauve-950/70">{t("cta.body")}</p>
        <div class="flex flex-col items-center gap-3 sm:flex-row">
          <a href={demoUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-1 bg-mauve-950 px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider text-white hover:bg-mauve-900">{t("cta.tryDemo")}</a>
          <a href={githubUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-2 px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider text-mauve-950 inset-ring-1 inset-ring-mauve-950/30 hover:bg-mauve-950/10">
            <svg class="size-4" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" role="image"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            {t("cta.viewOnGitHub")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
