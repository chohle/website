---
const steps = [
  {
    n: "1",
    title: "Start a project",
    body: "Create a project for a client, set your rate, and you're ready to go. No lengthy setup.",
  },
  {
    n: "2",
    title: "Track the work",
    body: "Log hours and notes as you go, and keep the client's emails attached to the project they belong to.",
  },
  {
    n: "3",
    title: "Invoice & get paid",
    body: "Turn tracked work into a Swiss QR-bill in one click, send it, and watch it get marked as paid.",
  },
];
---

<section id="how-it-works" class="py-16">
  <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10">
    <div class="flex max-w-2xl flex-col gap-6">
      <div class="flex flex-col gap-2">
        <div class="text-sm/7 font-semibold text-mauve-700 dark:text-mauve-400">How it works</div>
        <h2 class="font-display text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">From kickoff to paid, in three steps.</h2>
      </div>
      <div class="text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">
        <p>batze follows the natural rhythm of freelance work — so the admin stays out of your way until you need it.</p>
      </div>
    </div>
    <div>
      <div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {steps.map((step) => (
          <div class="flex flex-col gap-4">
            <div class="flex size-10 items-center justify-center rounded-full bg-mauve-950 text-sm font-semibold text-white dark:bg-mauve-300 dark:text-mauve-950">{step.n}</div>
            <div class="flex flex-col gap-2">
              <h3 class="text-base/8 font-medium text-mauve-950 dark:text-white">{step.title}</h3>
              <p class="text-sm/7 text-mauve-700 dark:text-mauve-400">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
