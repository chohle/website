---
import Layout from "../../layouts/Layout.astro";
import { defaultLang, type Lang } from "../../i18n/config";
import { getPrivacy } from "../../i18n/privacy";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const content = getPrivacy(lang);

const prose =
  "mx-auto max-w-2xl text-base/8 text-mauve-700 dark:text-mauve-400 " +
  "[&>h2]:font-display [&>h2]:mt-10 [&>h2]:mb-3 [&>h2]:text-xl/8 [&>h2]:font-medium [&>h2]:tracking-tight [&>h2]:text-mauve-950 dark:[&>h2]:text-white " +
  "[&>p]:mt-4 [&>ul]:mt-4 [&>ul]:list-disc [&>ul]:space-y-2 [&>ul]:pl-6 [&>ul]:marker:text-mauve-400 " +
  "[&_a]:font-medium [&_a]:text-mauve-950 [&_a]:underline [&_a]:underline-offset-4 dark:[&_a]:text-white " +
  "[&_strong]:font-semibold [&_strong]:text-mauve-950 dark:[&_strong]:text-white";
---

<Layout title={content.meta.title} description={content.meta.description} lang={lang}>
  <section id="document" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex flex-col items-center gap-6">
        <h1 class="font-display max-w-4xl text-center text-5xl/12 font-medium tracking-tight text-balance sm:text-[3.5rem]/14 text-mauve-950 dark:text-white">{content.title}</h1>
        <div class="flex max-w-xl flex-col gap-4 text-center text-lg/8 text-mauve-700 dark:text-mauve-400">
          <p>{content.lastUpdated.label} {content.lastUpdated.date}.</p>
        </div>
      </div>

      <div class={prose}>
        <p set:html={content.intro} />

        {content.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.blocks.map((block) =>
              block.type === "ul" ? (
                <ul>
                  {block.items?.map((item) => <li>{item}</li>)}
                </ul>
              ) : (
                <p set:html={block.text} />
              )
            )}
          </>
        ))}
      </div>
    </div>
  </section>
</Layout>
