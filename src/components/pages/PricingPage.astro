---
import Layout from "../../layouts/Layout.astro";
import CallToAction from "../CallToAction.astro";
import Accordion from "../Accordion.astro";
import Eyebrow from "../Eyebrow.astro";
import { defaultLang, type Lang } from "../../i18n/config";
import { getPricing } from "../../i18n/pricing";
import { useTranslations } from "../../i18n/ui";
import { localize } from "../../i18n/utils";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const c = getPricing(lang);
const t = useTranslations(lang);

const githubUrl = "https://github.com/chohle/chohle";
const docsUrl = localize("/docs", lang);
const contactUrl = `mailto:${c.cloud.email}?subject=${encodeURIComponent("chohle Cloud")}`;

const cloudIcon = `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z" />`;
const serverIcon = `<path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Z" />`;
---

<Layout title={c.meta.title} description={c.meta.description} lang={lang}>
  <section class="py-16 sm:py-24">
    <div class="mx-auto w-full max-w-2xl px-6 text-center md:max-w-3xl lg:max-w-7xl lg:px-10">
      <h1 class="font-display mx-auto max-w-3xl text-4xl font-semibold tracking-[-0.03em] text-balance text-mauve-950 sm:text-6xl">{c.hero.headline}</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg/8 text-mauve-700">{c.hero.sub}</p>
    </div>
  </section>

  <section id="plans" class="py-16 sm:py-24">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 lg:grid-cols-2 lg:items-stretch">
        <div class="shape flex flex-col gap-6 bg-mauve-50 p-8 ring-1 ring-mauve-950/10 sm:p-10" data-reveal>
          <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
            <div class="flex items-center gap-2.5 text-mauve-950 dark:text-white">
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={serverIcon} />
              <span class="font-mono text-xs/6 font-semibold tracking-widest uppercase">{c.selector.selfHosted.name}</span>
            </div>
            <span class="bg-accent/15 px-2.5 py-1 text-xs/6 font-medium text-accent dark:bg-accent/25 dark:text-accent-light">{c.selector.selfHosted.tagline}</span>
          </div>
          <div class="flex flex-col gap-3">
            <p class="inline-flex items-baseline gap-2">
              <span class="font-serif text-5xl italic tracking-tight text-mauve-950">{c.selfHostedPlan.price}</span>
              <span class="text-sm/6 text-mauve-500">{c.selfHostedPlan.period}</span>
            </p>
            <p class="text-sm/7 text-mauve-700 dark:text-mauve-400">{c.selfHostedPlan.sub}</p>
          </div>
          <hr class="border-mauve-950/10 dark:border-white/10" />
          <ul class="grid grid-cols-1 gap-3 text-sm/6 text-mauve-700 sm:grid-cols-2 dark:text-mauve-400">
            {c.selfHostedPlan.features.map((feature) => (
              <li class="flex gap-3">
                <svg class="h-lh shrink-0 stroke-mauve-950 dark:stroke-white" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1" role="image"><path d="M1.5 6.5L5.5 11.5L11.5 1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto flex flex-col gap-3 pt-2 sm:flex-row">
            <a href={githubUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-5 py-2 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider btn-ink bg-mauve-950 text-white dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">
              <svg class="size-4" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" role="image"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
              {t("cta.viewOnGitHub")}
            </a>
            <a href={docsUrl} target="_blank" rel="noopener" class="btn-outline inline-flex shrink-0 items-center justify-center gap-1 px-5 py-2 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider text-mauve-950">{t("cta.readDocs")}</a>
          </div>
        </div>

        <div class="shape flex flex-col gap-6 bg-mauve-950/2.5 p-8 ring-1 ring-mauve-950/5 sm:p-10 dark:bg-white/5 dark:ring-white/10" data-reveal>
          <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
            <div class="flex items-center gap-2.5 text-mauve-950 dark:text-white">
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={cloudIcon} />
              <span class="font-mono text-xs/6 font-semibold tracking-widest uppercase">{c.selector.cloud.name}</span>
            </div>
            <span class="bg-mauve-950/10 px-2.5 py-1 text-xs/6 font-medium text-mauve-700 dark:bg-white/10 dark:text-mauve-300">{c.cloud.badge}</span>
          </div>
          <div class="flex flex-col gap-3">
            <h2 class="font-display text-2xl/9 font-medium tracking-tight text-pretty text-mauve-950 dark:text-white">{c.cloud.headline}</h2>
            <p class="text-sm/7 text-pretty text-mauve-700 dark:text-mauve-400">{c.cloud.body}</p>
          </div>
          <div class="mt-auto flex flex-col gap-3 pt-2">
            <a href={contactUrl} class="inline-flex w-fit shrink-0 items-center justify-center gap-1 rounded-full px-5 py-2 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider btn-ink bg-mauve-950 text-white dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">{c.cloud.cta}</a>
            <p class="text-sm/6 text-mauve-500">{c.cloud.note}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="faqs" class="py-16 sm:py-24">
    <div class="mx-auto grid w-full max-w-2xl grid-cols-1 gap-x-16 gap-y-10 px-6 md:max-w-3xl lg:max-w-7xl lg:grid-cols-[minmax(0,1fr)_1.4fr] lg:px-10">
      <div class="flex flex-col gap-6 lg:sticky lg:top-28 lg:self-start" data-reveal>
        <div class="flex flex-col gap-3">
          <Eyebrow>{t("eyebrow.faq")}</Eyebrow>
          <h2 class="font-display text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">{c.faqsTitle}</h2>
        </div>
        <p class="max-w-md text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">{c.faqsIntro}</p>
      </div>
      <div data-reveal>
        <Accordion items={c.faqs} idPrefix="pricing-faq" />
      </div>
    </div>
  </section>

  <CallToAction lang={lang} />
</Layout>
