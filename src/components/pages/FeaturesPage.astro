---
import Layout from "../../layouts/Layout.astro";
import Screenshot from "../Screenshot.astro";
import CallToAction from "../CallToAction.astro";
import { defaultLang, type Lang } from "../../i18n/config";
import { getFeatures } from "../../i18n/features";
import { useTranslations } from "../../i18n/ui";
import { localize } from "../../i18n/utils";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const c = getFeatures(lang);
const t = useTranslations(lang);

const demoUrl = "https://app.chohle.ch";
const docsUrl = localize("/docs", lang);

// Real app screenshots captured per locale from the running app, stored under
// /public/screenshots as `<shot>-<lang>.jpg`.
const shotSrc = (shot: string) => `/screenshots/${shot}-${lang}.jpg`;

const frame = [
  { color: "green", placement: "bottom-right" },
  { color: "blue", placement: "bottom-left" },
  { color: "brown", placement: "bottom-right" },
  { color: "green", placement: "bottom-left" },
  { color: "blue", placement: "bottom-right" },
] as const;

const rows = c.lightCards.map((card, i) => ({ ...card, ...frame[i % frame.length] }));
---

<Layout title={c.meta.title} description={c.meta.description} lang={lang}>
  <!-- Hero -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto w-full max-w-2xl px-6 text-center md:max-w-3xl lg:max-w-7xl lg:px-10" data-reveal>
      <h1 class="font-display mx-auto max-w-3xl text-4xl font-extrabold tracking-[-0.03em] text-balance text-white sm:text-6xl">{c.hero.headline}</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg/8 text-mauve-400">{c.hero.sub}</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={demoUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full bg-accent px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider text-mauve-950 hover:bg-accent-light">{t("cta.tryDemo")}</a>
        <a href={docsUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider text-white inset-ring-1 inset-ring-white/15 hover:bg-white/5">{t("cta.readDocs")}</a>
      </div>
    </div>
  </section>

  <!-- Alternating feature walkthrough -->
  <section id="walkthrough" class="py-16 sm:py-24">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex max-w-3xl flex-col gap-3" data-reveal>
        <h2 class="font-mono text-xs/5 font-semibold tracking-widest text-accent uppercase dark:text-accent-light">{c.lightSection.eyebrow}</h2>
        <p class="font-display text-4xl font-medium tracking-tighter text-pretty text-mauve-950 sm:text-5xl dark:text-white">{c.lightSection.heading}</p>
      </div>

      <div class="mt-16 flex flex-col gap-20 sm:gap-28">
        {rows.map((card, i) => (
          <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-16" data-reveal>
            <div class={`flex flex-col gap-5 ${i % 2 === 1 ? "lg:order-2" : ""}`}>
              <div class="flex flex-wrap items-center gap-3">
                <span class="font-mono text-xs/6 font-semibold tracking-widest text-accent uppercase dark:text-accent-light">{card.eyebrow}</span>
                {card.tag && (
                  <span class="inline-flex items-center rounded-full bg-amber-400/15 px-2.5 py-0.5 font-mono text-[0.65rem] font-semibold tracking-widest text-amber-700 uppercase ring-1 ring-amber-500/30 ring-inset dark:text-amber-300">{card.tag}</span>
                )}
              </div>
              <h3 class="font-display text-2xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-3xl/10 dark:text-white">{card.title}</h3>
              <p class="max-w-xl text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">{card.description}</p>
              <div class="mt-1 flex items-center gap-5">
                <a href={demoUrl} target="_blank" rel="noopener" class="group/link inline-flex items-center gap-2 text-sm/7 font-medium text-mauve-950 dark:text-white">
                  {t("cta.tryDemo")}
                  <svg class="inline-block transition-transform group-hover/link:translate-x-0.5" width="13" height="7" viewBox="0 0 13 7" fill="none" stroke-width="1" role="image"><path d="M12.5049 3.49512L0.504883 3.49512" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /><path d="M9.5 6.5L12.5 3.5L9.5 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
                <a href={docsUrl} target="_blank" rel="noopener" class="text-sm/7 font-medium text-mauve-600 transition-colors hover:text-mauve-950 dark:text-mauve-400 dark:hover:text-white">{t("cta.readDocs")}</a>
              </div>
            </div>
            <div class={`relative overflow-hidden rounded-xl dark:after:absolute dark:after:inset-0 dark:after:rounded-xl dark:after:outline-1 dark:after:-outline-offset-1 dark:after:outline-white/10 ${i % 2 === 1 ? "lg:order-1" : ""}`}>
              <Screenshot color={card.color} placement={card.placement}>
                <img src={shotSrc(card.shot)} alt={card.title} width="1456" height="1080" loading="lazy" data-zoomable class="cursor-zoom-in bg-white" />
              </Screenshot>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dark "open by design" panel -->
  <div class="mx-2 mt-2 rounded-4xl bg-mauve-950 py-24 sm:py-32 dark:ring-1 dark:ring-white/10">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex max-w-3xl flex-col gap-3" data-reveal>
        <h2 class="font-mono text-xs/5 font-semibold tracking-widest text-accent-light uppercase">{c.darkSection.eyebrow}</h2>
        <p class="font-display text-4xl font-medium tracking-tighter text-pretty text-white sm:text-5xl">{c.darkSection.heading}</p>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-10 sm:mt-16 sm:grid-cols-2">
        {c.darkCards.map((card) => (
          <div class="flex flex-col gap-3 border-t border-white/10 pt-6" data-reveal>
            <span class="font-mono text-xs/6 font-semibold tracking-widest text-accent-light uppercase">{card.eyebrow}</span>
            <h3 class="font-display text-xl/8 font-medium tracking-tight text-white">{card.title}</h3>
            <p class="text-sm/7 text-pretty text-mauve-400">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <CallToAction lang={lang} />
</Layout>
