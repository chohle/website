---
import Screenshot from "./Screenshot.astro";

// home-02 layout: one section-level "See how it works" link (after the
// subheadline) pointing to the full /features page. The cards below are a
// teaser — the complete, documented feature set lives on /features.
const featuresPage = "/features";
---

<section id="features" class="py-16">
  <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10">
    <div class="flex max-w-2xl flex-col gap-6">
      <div class="flex flex-col gap-2">
        <h2 class="font-display text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">From the first quote to the final payment.</h2>
      </div>
      <div class="text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">
        <p>
          batze keeps invoicing, projects, and client email in one calm place — so nothing falls through the cracks
          between the work and getting paid for it.
        </p>
      </div>
      <a href={featuresPage} class="inline-flex items-center gap-2 text-sm/7 font-medium text-mauve-950 dark:text-white">
        See how it works
        <svg class="inline-block" width="13" height="7" viewBox="0 0 13 7" fill="none" stroke-width="1" role="image"><path d="M12.5049 3.49512L0.504883 3.49512" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /><path d="M9.5 6.5L12.5 3.5L9.5 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
    <div>
      <div class="grid grid-cols-1 gap-2 lg:grid-cols-2">
        <!-- Feature 1: Invoicing -->
        <div class="rounded-lg bg-mauve-950/2.5 p-2 dark:bg-white/5">
          <div class="relative overflow-hidden rounded-sm dark:after:absolute dark:after:inset-0 dark:after:rounded-sm dark:after:outline-1 dark:after:-outline-offset-1 dark:after:outline-white/10">
            <Screenshot color="purple" placement="bottom-right">
              <img src="https://placehold.co/1000x800?text=batze" alt="" width="1000" height="800" class="bg-white/75 sm:hidden dark:bg-black/75" />
              <img src="https://placehold.co/1800x660?text=batze" alt="" width="1800" height="660" class="bg-white/75 max-sm:hidden lg:hidden dark:bg-black/75" />
              <img src="https://placehold.co/1300x1300?text=batze" alt="" width="1300" height="1300" class="bg-white/75 max-lg:hidden xl:hidden dark:bg-black/75" />
              <img src="https://placehold.co/1800x1250?text=batze" alt="" width="1800" height="1250" class="bg-white/75 max-xl:hidden dark:bg-black/75" />
            </Screenshot>
          </div>
          <div class="p-6 sm:p-10 lg:p-6">
            <h3 class="text-base/8 font-medium text-mauve-950 dark:text-white">Invoicing</h3>
            <div class="mt-2 flex flex-col gap-4 text-sm/7 text-mauve-700 dark:text-mauve-400">
              <p>Create a Swiss QR-bill in seconds, send it, and let batze track what's paid and nudge what's overdue.</p>
            </div>
          </div>
        </div>
        <!-- Feature 2: Projects -->
        <div class="rounded-lg bg-mauve-950/2.5 p-2 dark:bg-white/5">
          <div class="relative overflow-hidden rounded-sm dark:after:absolute dark:after:inset-0 dark:after:rounded-sm dark:after:outline-1 dark:after:-outline-offset-1 dark:after:outline-white/10">
            <Screenshot color="blue" placement="bottom-left">
              <img src="https://placehold.co/1000x800?text=batze" alt="" width="1000" height="800" class="bg-white/75 sm:hidden dark:bg-black/75" />
              <img src="https://placehold.co/1800x660?text=batze" alt="" width="1800" height="660" class="bg-white/75 max-sm:hidden lg:hidden dark:bg-black/75" />
              <img src="https://placehold.co/1300x1300?text=batze" alt="" width="1300" height="1300" class="bg-white/75 max-lg:hidden xl:hidden dark:bg-black/75" />
              <img src="https://placehold.co/1800x1250?text=batze" alt="" width="1800" height="1250" class="bg-white/75 max-xl:hidden dark:bg-black/75" />
            </Screenshot>
          </div>
          <div class="p-6 sm:p-10 lg:p-6">
            <h3 class="text-base/8 font-medium text-mauve-950 dark:text-white">Projects</h3>
            <div class="mt-2 flex flex-col gap-4 text-sm/7 text-mauve-700 dark:text-mauve-400">
              <p>Group work into projects, track your hours, and know which clients are worth it before you take on more.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
