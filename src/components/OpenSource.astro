---
import { defaultLang, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { localize } from "../i18n/utils";
import { getHome } from "../i18n/home";
import Eyebrow from "./Eyebrow.astro";

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const c = getHome(lang).open;

const githubUrl = "https://github.com/chohle/chohle";
const docsUrl = localize("/docs", lang);
---

<section id="open-source" class="py-16">
  <div class="mx-auto flex w-full max-w-2xl flex-col items-center gap-10 px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
    <div class="flex flex-col gap-6" data-reveal>
      <div class="flex flex-col items-center gap-3">
        <Eyebrow class="text-center">{c.eyebrow}</Eyebrow>
        <h2 class="font-display max-w-3xl text-center text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">{c.headline}</h2>
      </div>
      <div class="flex max-w-3xl flex-col gap-4 text-center text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">
        <p>{c.body}</p>
      </div>
    </div>

    <!-- Pillars, as pricing-style cards -->
    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {c.items.map((item) => (
        <div class="flex flex-col gap-3 rounded-3xl bg-mauve-950/2.5 p-8 ring-1 ring-mauve-950/10 dark:bg-white/5 dark:ring-white/15" data-reveal>
          <span class="w-fit bg-accent/15 px-2.5 py-1 font-mono text-[0.7rem]/6 font-medium tracking-wider text-accent uppercase dark:bg-accent/25 dark:text-accent-light">{item.tag}</span>
          <h3 class="text-base/7 font-medium text-mauve-950 dark:text-white">{item.title}</h3>
          <p class="text-sm/7 text-mauve-700 dark:text-mauve-400">{item.desc}</p>
        </div>
      ))}
    </div>

    <div class="flex items-center gap-4" data-reveal>
      <a href={githubUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-5 py-2 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider bg-mauve-950 text-white hover:bg-mauve-800 dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">
        <svg class="size-4" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" role="image"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        {t("cta.viewOnGitHub")}
      </a>
      <a href={docsUrl} target="_blank" rel="noopener" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-5 py-2 font-mono text-[0.8rem]/7 font-medium uppercase tracking-wider text-mauve-950 hover:bg-mauve-950/10 dark:text-white dark:hover:bg-white/10">{t("cta.readDocs")}</a>
    </div>
  </div>
</section>
