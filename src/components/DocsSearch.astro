---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  aria-label="Search the docs"
  class={`flex h-8 items-center gap-2 rounded-lg bg-mauve-950/5 px-3 text-sm text-mauve-500 ring-1 ring-mauve-950/10 ring-inset transition hover:ring-mauve-950/20 dark:bg-white/5 dark:ring-white/10 dark:hover:ring-white/20 ${className}`}
>
  <svg class="size-4 shrink-0 stroke-mauve-500" fill="none" viewBox="0 0 20 20" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m17 17-3.5-3.5M15 9a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z" /></svg>
  <span class="flex-auto text-left">Search the docs…</span>
  <kbd class="hidden font-mono text-[0.65rem] text-mauve-400 sm:block">⌘K</kbd>
</button>
