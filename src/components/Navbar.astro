---
import { langs, languages, defaultLang, type Lang } from "../i18n/config";
import { localize, switchLocalePath } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: "/pricing", label: t("nav.pricing") },
  { href: "/about", label: t("nav.about") },
  { href: "/docs", label: t("nav.docs"), blank: true },
];

const demoUrl = "#";

const linkClass =
  "group inline-flex items-center justify-between gap-2 text-3xl/10 font-medium text-mauve-950 lg:text-sm/7 dark:text-white";
const demoBtn =
  "inline-flex shrink-0 items-center justify-center gap-1 rounded-full px-3 py-1 text-sm/7 font-medium bg-mauve-950 text-white hover:bg-mauve-800 dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200";
---

<header class="sticky top-0 z-10 bg-mauve-100 dark:bg-mauve-950">
  <style>:root { --scroll-padding-top: 5.25rem }</style>
  <nav>
    <div class="mx-auto flex h-(--scroll-padding-top) max-w-7xl items-center gap-4 px-6 lg:px-10">
      <div class="flex flex-1 gap-8 max-lg:hidden">
        {links.map((link) => (
          <a href={link.blank ? link.href : localize(link.href, lang)} target={link.blank ? "_blank" : undefined} rel={link.blank ? "noopener" : undefined} class={linkClass}>
            {link.label}
            <span class="inline-flex p-1.5 opacity-0 group-hover:opacity-100 lg:hidden" aria-hidden="true">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
            </span>
          </a>
        ))}
      </div>

      <div class="flex items-center">
        <a href={localize("/", lang)} class="inline-flex items-center text-mauve-950 dark:text-white" aria-label="chohle home">
          <Logo class="h-5 w-auto" />
        </a>
      </div>

      <div class="flex flex-1 items-center justify-end gap-4">
        <a href={demoUrl} class={`${demoBtn} max-lg:hidden`}>{t("cta.tryDemo")}</a>

        <div class="max-lg:hidden">
          <LanguageSwitcher lang={lang} />
        </div>

        <button
          command="show-modal"
          commandfor="mobile-menu"
          aria-label="Toggle menu"
          class="inline-flex rounded-full p-1.5 text-mauve-950 hover:bg-mauve-950/10 lg:hidden dark:text-white dark:hover:bg-white/10"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-6">
            <path fill-rule="evenodd" d="M3.748 8.248a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75ZM3.748 15.75a.75.75 0 0 1 .75-.751h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>

    <el-dialog class="lg:hidden">
      <dialog id="mobile-menu" class="backdrop:bg-transparent">
        <el-dialog-panel class="fixed inset-0 bg-mauve-100 px-6 py-6 lg:px-10 dark:bg-mauve-950">
          <div class="flex justify-end">
            <button
              command="close"
              commandfor="mobile-menu"
              aria-label="Toggle menu"
              class="inline-flex rounded-full p-1.5 text-mauve-950 hover:bg-mauve-950/10 dark:text-white dark:hover:bg-white/10"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <div class="mt-6 flex flex-col gap-6">
            {links.map((link) => (
              <a href={link.blank ? link.href : localize(link.href, lang)} target={link.blank ? "_blank" : undefined} rel={link.blank ? "noopener" : undefined} class={linkClass}>
                {link.label}
                <span class="inline-flex p-1.5 opacity-0 group-hover:opacity-100 lg:hidden" aria-hidden="true">
                  <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                </span>
              </a>
            ))}
            <a href={demoUrl} class={`${demoBtn} mt-2 self-start`}>{t("cta.tryDemo")}</a>
            <div class="mt-2 flex items-center gap-4 text-sm font-medium" aria-label={t("lang.label")}>
              {langs.map((l) => (
                <a
                  href={switchLocalePath(Astro.url, l)}
                  hreflang={l}
                  aria-current={l === lang ? "true" : undefined}
                  class={l === lang ? "text-mauve-950 dark:text-white" : "text-mauve-500 hover:text-mauve-950 dark:text-mauve-400 dark:hover:text-white"}
                >
                  {languages[l]}
                </a>
              ))}
            </div>
          </div>
        </el-dialog-panel>
      </dialog>
    </el-dialog>
  </nav>
</header>
