---
// Gallery lightbox. Any <img data-zoomable> (or any image inside a
// [data-doc-content] region) opens full-size on click. All eligible images on
// the page form one gallery: move through them with the arrows, the keyboard
// (←/→), or by swiping. Close with the ✕, a backdrop tap, Escape, or swipe-down.
// Images inside a link are skipped so they keep navigating.
---

<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden touch-none items-center justify-center bg-black/90 p-4 opacity-0 backdrop-blur-sm transition-opacity duration-200 sm:p-12"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <img
    id="lightbox-img"
    src=""
    alt=""
    draggable="false"
    class="max-h-full max-w-full scale-95 rounded-lg shadow-2xl ring-1 ring-white/10 transition-transform duration-200 select-none"
  />

  <button
    id="lightbox-close"
    type="button"
    aria-label="Close"
    class="absolute top-4 right-4 inline-flex size-10 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition-colors hover:bg-white/20 focus:outline-none"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
  </button>

  <button
    id="lightbox-prev"
    type="button"
    aria-label="Previous"
    class="absolute top-1/2 left-3 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition-colors hover:bg-white/20 focus:outline-none sm:left-5"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
  </button>

  <button
    id="lightbox-next"
    type="button"
    aria-label="Next"
    class="absolute top-1/2 right-3 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition-colors hover:bg-white/20 focus:outline-none sm:right-5"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
  </button>

  <div
    id="lightbox-counter"
    class="absolute bottom-5 left-1/2 -translate-x-1/2 rounded-full bg-white/10 px-3 py-1 font-mono text-xs text-white backdrop-blur"
  ></div>
</div>

<script>
  (() => {
    const box = document.getElementById("lightbox");
    const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const counter = document.getElementById("lightbox-counter");
    const btnClose = document.getElementById("lightbox-close");
    const btnPrev = document.getElementById("lightbox-prev");
    const btnNext = document.getElementById("lightbox-next");
    if (!box || !img || !counter || !btnClose || !btnPrev || !btnNext) return;

    let items: HTMLImageElement[] = [];
    let index = 0;

    const isZoomable = (el: Element): el is HTMLImageElement =>
      el instanceof HTMLImageElement &&
      el.id !== "lightbox-img" &&
      !el.closest("a") &&
      (el.hasAttribute("data-zoomable") || !!el.closest("[data-doc-content]"));

    const isOpen = () => !box.classList.contains("hidden");
    const toggle = (el: HTMLElement, show: boolean) => { el.style.display = show ? "" : "none"; };

    const preload = (i: number) => {
      const it = items[i];
      if (!it) return;
      const p = new Image();
      p.src = it.currentSrc || it.src;
    };

    const render = () => {
      const it = items[index];
      if (!it) return;
      img.src = it.currentSrc || it.src;
      img.alt = it.alt;
      const many = items.length > 1;
      toggle(btnPrev, many);
      toggle(btnNext, many);
      toggle(counter, many);
      if (many) {
        counter.textContent = `${index + 1} / ${items.length}`;
        preload((index + 1) % items.length);
        preload((index - 1 + items.length) % items.length);
      }
    };

    const go = (delta: number) => {
      if (items.length < 2) return;
      index = (index + delta + items.length) % items.length;
      render();
    };

    const open = (target: HTMLImageElement) => {
      items = Array.from(document.querySelectorAll<HTMLImageElement>("img")).filter(isZoomable);
      index = Math.max(0, items.indexOf(target));
      render();
      box.classList.remove("hidden");
      box.classList.add("flex");
      box.setAttribute("aria-hidden", "false");
      document.documentElement.style.overflow = "hidden";
      // Double rAF so the initial opacity-0 / scale-95 paints before transitioning in.
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          box.classList.remove("opacity-0");
          img.classList.remove("scale-95");
        })
      );
    };

    const close = () => {
      box.classList.add("opacity-0");
      img.classList.add("scale-95");
      box.setAttribute("aria-hidden", "true");
      document.documentElement.style.overflow = "";
      const done = () => {
        box.classList.add("hidden");
        box.classList.remove("flex");
        img.src = "";
        box.removeEventListener("transitionend", done);
      };
      box.addEventListener("transitionend", done);
    };

    document.addEventListener("click", (e) => {
      const t = e.target as Element;
      if (t instanceof HTMLImageElement && isZoomable(t)) {
        e.preventDefault();
        open(t);
      }
    });

    box.addEventListener("click", (e) => {
      if (e.target === box) close();
    });
    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", (e) => { e.stopPropagation(); go(-1); });
    btnNext.addEventListener("click", (e) => { e.stopPropagation(); go(1); });

    document.addEventListener("keydown", (e) => {
      if (!isOpen()) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") go(-1);
      else if (e.key === "ArrowRight") go(1);
    });

    let startX = 0, startY = 0, swiping = false;
    box.addEventListener("touchstart", (e) => {
      if (e.touches.length !== 1) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      swiping = true;
    }, { passive: true });
    box.addEventListener("touchend", (e) => {
      if (!swiping) return;
      swiping = false;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      const absX = Math.abs(dx), absY = Math.abs(dy);
      if (absX > 50 && absX > absY) go(dx < 0 ? 1 : -1);
      else if (dy > 80 && absY > absX) close();
    }, { passive: true });
  })();
</script>
