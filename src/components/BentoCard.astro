---
interface Props {
  dark?: boolean;
  eyebrow: string;
  title: string;
  description: string;
  graphic: string; // placeholder image url for now
  fade?: ("top" | "bottom")[];
  class?: string;
}

const { dark = false, eyebrow, title, description, graphic, fade = [], class: className = "" } = Astro.props;
---

<div
  data-dark={dark ? "true" : undefined}
  class={`group relative flex flex-col overflow-hidden rounded-lg bg-white shadow-xs ring-1 ring-black/5 data-dark:bg-mauve-900 data-dark:ring-white/15 ${className}`}
>
  <div class="relative h-80 shrink-0">
    <img src={graphic} alt="" class="absolute inset-0 size-full object-cover" />
    {fade.includes("top") && (
      <div class="absolute inset-0 bg-linear-to-b from-white to-50% group-data-dark:from-mauve-900 group-data-dark:from-[-25%]"></div>
    )}
    {fade.includes("bottom") && (
      <div class="absolute inset-0 bg-linear-to-t from-white to-50% group-data-dark:from-mauve-900 group-data-dark:from-[-25%]"></div>
    )}
  </div>
  <div class="relative p-10">
    <h3 class="font-mono text-xs/5 font-semibold tracking-widest text-mauve-500 uppercase group-data-dark:text-mauve-400">{eyebrow}</h3>
    <p class="mt-1 text-2xl/8 font-medium tracking-tight text-mauve-950 group-data-dark:text-white">{title}</p>
    <p class="mt-2 max-w-[600px] text-sm/6 text-mauve-600 group-data-dark:text-mauve-400">{description}</p>
  </div>
</div>
