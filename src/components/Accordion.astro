---
// Shared FAQ accordion — same look on every page (home, pricing, …).
// Native <details> with a shared `name` ⇒ only one item open at a time, no JS.
// Each item is its own card carrying the signature shape, with a mono row
// number, a plus that rotates into a close mark, and a smooth expand where
// the platform can animate ::details-content (see global.css).
interface Props {
  items: { q: string; a: string }[];
  idPrefix?: string;
  class?: string;
}
const { items, idPrefix = "faq", class: className = "" } = Astro.props;
---

<div class={`flex flex-col gap-3 ${className}`}>
  {items.map((faq, i) => (
    <details name={idPrefix} class="acc group shape overflow-hidden border border-mauve-950/10 bg-white transition-colors open:border-mauve-950/30 hover:border-mauve-950/30">
      <summary class="flex cursor-pointer list-none items-center gap-4 px-6 py-5 text-left select-none transition-colors hover:bg-mauve-50 group-open:bg-mauve-50/70 [&::-webkit-details-marker]:hidden">
        <span class="w-6 shrink-0 font-mono text-xs/7 text-mauve-400 transition-colors group-open:text-mauve-950" aria-hidden="true">{(i + 1).toString().padStart(2, "0")}</span>
        <span class="flex-1 text-base/7 font-medium text-mauve-950">{faq.q}</span>
        <svg class="size-4 shrink-0 text-mauve-500 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <path d="M8 1v14M1 8h14" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="px-6 pt-4 pb-6 pl-16 pr-14 text-sm/7 text-mauve-700">
        <p>{faq.a}</p>
      </div>
    </details>
  ))}
</div>
