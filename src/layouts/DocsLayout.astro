---
import "../styles/global.css";
import DocsNav from "../components/DocsNav.astro";
import DocsSearch from "../components/DocsSearch.astro";
import HeroPattern from "../components/HeroPattern.astro";
import { docsFlat } from "../lib/docs-nav";

interface Props {
  title?: string;
  description?: string;
}
const { title = "batze docs", description = "Documentation for batze." } = Astro.props;

const current = (Astro.url.pathname.replace(/\/+$/, "") || "/docs");
const idx = docsFlat.findIndex((l) => l.href === current);
const prev = idx > 0 ? docsFlat[idx - 1] : null;
const next = idx >= 0 && idx < docsFlat.length - 1 ? docsFlat[idx + 1] : null;

const year = new Date().getFullYear();

const prose =
  "text-base/8 text-mauve-700 dark:text-mauve-400 " +
  "[&>h1]:font-display [&>h1]:mb-2 [&>h1]:text-4xl [&>h1]:font-medium [&>h1]:tracking-tight [&>h1]:text-balance [&>h1]:text-mauve-950 dark:[&>h1]:text-white " +
  "[&>h2]:font-display [&>h2]:mt-12 [&>h2]:mb-4 [&>h2]:scroll-mt-24 [&>h2]:text-2xl/8 [&>h2]:font-medium [&>h2]:tracking-tight [&>h2]:text-mauve-950 dark:[&>h2]:text-white " +
  "[&>h3]:mt-8 [&>h3]:mb-2 [&>h3]:text-lg/7 [&>h3]:font-medium [&>h3]:text-mauve-950 dark:[&>h3]:text-white " +
  "[&>p]:mt-4 [&>ul]:mt-4 [&>ul]:list-disc [&>ul]:space-y-2 [&>ul]:pl-6 [&>ul]:marker:text-mauve-400 [&>ol]:mt-4 [&>ol]:list-decimal [&>ol]:space-y-2 [&>ol]:pl-6 " +
  "[&_a]:font-medium [&_a]:text-mauve-950 [&_a]:underline [&_a]:underline-offset-4 dark:[&_a]:text-white " +
  "[&_strong]:font-semibold [&_strong]:text-mauve-950 dark:[&_strong]:text-white " +
  "[&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-mauve-950/5 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[0.9em] [&_:not(pre)>code]:text-mauve-950 dark:[&_:not(pre)>code]:bg-white/10 dark:[&_:not(pre)>code]:text-white";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="font-sans">

    <!-- Mobile nav dialog -->
    <el-dialog class="lg:hidden">
      <dialog id="docs-menu" class="backdrop:bg-mauve-950/30">
        <el-dialog-panel class="fixed inset-y-0 left-0 w-80 max-w-[80%] overflow-y-auto bg-mauve-100 px-6 py-6 dark:bg-mauve-950">
          <div class="flex items-center justify-between">
            <a href="/docs" class="font-display text-xl font-semibold tracking-tight text-mauve-950 dark:text-white">batze <span class="text-mauve-500">docs</span></a>
            <button command="close" commandfor="docs-menu" aria-label="Close docs menu" class="inline-flex rounded-full p-1.5 text-mauve-950 hover:bg-mauve-950/10 dark:text-white dark:hover:bg-white/10">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
            </button>
          </div>
          <nav class="mt-8"><DocsNav current={current} /></nav>
        </el-dialog-panel>
      </dialog>
    </el-dialog>

    <!-- Desktop fixed sidebar -->
    <div class="hidden lg:fixed lg:inset-y-0 lg:left-0 lg:z-30 lg:flex lg:w-72 lg:flex-col lg:overflow-y-auto lg:border-r lg:border-mauve-950/10 lg:bg-mauve-100 lg:px-6 lg:py-8 dark:lg:border-white/10 dark:lg:bg-mauve-950">
      <a href="/docs" class="font-display text-2xl font-semibold tracking-tight text-mauve-950 dark:text-white">batze <span class="text-mauve-500">docs</span></a>
      <a href="/" class="mt-2 inline-flex items-center gap-1 text-sm/6 text-mauve-600 hover:text-mauve-950 dark:text-mauve-400 dark:hover:text-white">
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
        Back to site
      </a>
      <nav class="mt-10"><DocsNav current={current} /></nav>
    </div>

    <!-- Content -->
    <div class="lg:pl-72">
      <!-- Header bar -->
      <header class="fixed inset-x-0 top-0 z-30 flex h-14 items-center gap-4 border-b border-mauve-950/10 bg-mauve-100/80 px-4 backdrop-blur-md sm:px-6 lg:left-72 lg:px-8 dark:border-white/10 dark:bg-mauve-950/80">
        <button command="show-modal" commandfor="docs-menu" aria-label="Open docs menu" class="inline-flex shrink-0 rounded-md p-1.5 text-mauve-700 hover:bg-mauve-950/10 lg:hidden dark:text-mauve-300 dark:hover:bg-white/10">
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-5"><path fill-rule="evenodd" d="M3.748 8.248a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75ZM3.748 15.75a.75.75 0 0 1 .75-.751h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" /></svg>
        </button>
        <a href="/docs" class="font-display shrink-0 text-lg font-semibold tracking-tight text-mauve-950 lg:hidden dark:text-white">batze <span class="text-mauve-500">docs</span></a>
        <DocsSearch class="max-w-xs flex-1 max-lg:hidden" />
        <div class="ml-auto flex items-center gap-3 sm:gap-5">
          <a href="/" class="hidden text-sm/5 text-mauve-700 hover:text-mauve-950 sm:block dark:text-mauve-400 dark:hover:text-white">Back to site</a>
          <a href="#" aria-label="GitHub" class="text-mauve-700 hover:text-mauve-950 dark:text-mauve-400 dark:hover:text-white"><svg class="size-5" viewBox="0 0 24 24" fill="currentColor" role="image"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg></a>
          <a href="#" class="inline-flex shrink-0 items-center justify-center rounded-full px-3 py-1 text-sm/7 font-medium bg-mauve-950 text-white hover:bg-mauve-800 dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">Try the demo</a>
        </div>
      </header>

      <div class="relative">
        <HeroPattern />
        <div class="mx-auto flex w-full max-w-6xl gap-12 px-6 pt-24 pb-16 lg:px-12">
        <main class="min-w-0 flex-1">
          <div class="max-w-3xl">
        <article class={prose}>
          <slot />
        </article>

        {(prev || next) && (
          <div class="mt-16 flex justify-between gap-6 border-t border-mauve-950/10 pt-8 dark:border-white/10">
            {prev ? (
              <a href={prev.href} class="group flex flex-col gap-1">
                <span class="text-xs/5 text-mauve-500">Previous</span>
                <span class="inline-flex items-center gap-2 text-sm/6 font-medium text-mauve-950 dark:text-white">
                  <svg class="size-4 transition group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
                  {prev.title}
                </span>
              </a>
            ) : <span />}
            {next && (
              <a href={next.href} class="group flex flex-col items-end gap-1 text-right">
                <span class="text-xs/5 text-mauve-500">Next</span>
                <span class="inline-flex items-center gap-2 text-sm/6 font-medium text-mauve-950 dark:text-white">
                  {next.title}
                  <svg class="size-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                </span>
              </a>
            )}
          </div>
        )}

        <footer class="mt-16 flex items-center justify-between gap-6 text-sm/6 text-mauve-500">
          <span>© {year} batze</span>
          <div class="flex items-center gap-6">
            <a href="/" class="hover:text-mauve-950 dark:hover:text-white">Home</a>
            <a href="#" class="hover:text-mauve-950 dark:hover:text-white">GitHub</a>
          </div>
        </footer>
          </div>
        </main>

        <aside id="toc" class="hidden w-56 shrink-0 xl:block">
          <div class="sticky top-16">
            <h2 class="text-xs font-semibold text-mauve-950 dark:text-white">On this page</h2>
            <ul id="toc-list" class="mt-3 flex flex-col border-l border-mauve-950/10 dark:border-white/10"></ul>
          </div>
        </aside>
        </div>
      </div>
    </div>

    <script>
      import "@tailwindplus/elements";
    </script>

    <script>
      const article = document.querySelector("article");
      const list = document.getElementById("toc-list");
      const aside = document.getElementById("toc");
      if (article && list && aside) {
        const headings = Array.from(article.querySelectorAll("h2, h3"));
        if (headings.length === 0) {
          aside.remove();
        } else {
          const links: HTMLAnchorElement[] = [];
          for (const h of headings) {
            if (!h.id) {
              h.id = (h.textContent || "").trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
            }
            const li = document.createElement("li");
            const a = document.createElement("a");
            a.href = "#" + h.id;
            a.textContent = h.textContent;
            a.dataset.id = h.id;
            const indent = h.tagName === "H3" ? "pl-8" : "pl-4";
            a.className = "-ml-px block border-l border-transparent " + indent + " py-1 text-sm text-mauve-600 transition hover:text-mauve-950 dark:text-mauve-400 dark:hover:text-white";
            li.appendChild(a);
            list.appendChild(li);
            links.push(a);
          }
          let activeId: string | null = null;
          const setActive = (id: string) => {
            if (id === activeId) return;
            activeId = id;
            for (const a of links) {
              const on = a.dataset.id === id;
              a.classList.toggle("border-mauve-950", on);
              a.classList.toggle("dark:border-white", on);
              a.classList.toggle("font-medium", on);
              a.classList.toggle("text-mauve-950", on);
              a.classList.toggle("dark:text-white", on);
              a.classList.toggle("border-transparent", !on);
              a.classList.toggle("text-mauve-600", !on);
              a.classList.toggle("dark:text-mauve-400", !on);
            }
          };
          const offset = 100;
          const onScroll = () => {
            let current = headings[0].id;
            for (const h of headings) {
              if (h.getBoundingClientRect().top - offset <= 0) current = h.id;
              else break;
            }
            setActive(current);
          };
          document.addEventListener("scroll", onScroll, { passive: true });
          window.addEventListener("resize", onScroll, { passive: true });
          onScroll();
        }
      }
    </script>
  </body>
</html>
