---
import Home from "../../components/pages/Home.astro";
import { langs, defaultLang, type Lang } from "../../i18n/config";

export function getStaticPaths() {
  return langs.filter((l) => l !== defaultLang).map((l) => ({ params: { lang: l } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<Home lang={lang} />
