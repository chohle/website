---
import AboutPage from "../../components/pages/AboutPage.astro";
import { langs, defaultLang, type Lang } from "../../i18n/config";

export function getStaticPaths() {
  return langs.filter((l) => l !== defaultLang).map((l) => ({ params: { lang: l } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<AboutPage lang={lang} />
