---
import Layout from "../layouts/Layout.astro";
import CallToAction from "../components/CallToAction.astro";

const demoUrl = "#";
const githubUrl = "#";
const docsUrl = "#";

const principles = [
  {
    title: "Open by default",
    desc: "Every line is public. It's how I learn — and it means the tool genuinely belongs to whoever uses it.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />`,
  },
  {
    title: "Calm by design",
    desc: "No dashboards screaming for attention. batze does the few things you need, quietly, and gets out of the way.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />`,
  },
  {
    title: "Built for Switzerland",
    desc: "QR-bills, VAT, the formats and rules Swiss businesses actually deal with — handled properly, not bolted on.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />`,
  },
  {
    title: "Yours to keep",
    desc: "Your data lives on your server, in open formats, exportable any time. No lock-in, no hostage-taking.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />`,
  },
];
---

<Layout
  title="batze — About"
  description="batze started as a project to learn Node.js and Nuxt, built for a friend who runs an IT company — and grew into a calm, open-source invoicing and projects tool anyone can use."
>
  <!-- Hero: two-column with photo -->
  <section id="hero" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl gap-16 px-6 max-xl:flex-col md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex flex-1 flex-col items-start justify-center gap-6">
        <div class="text-sm/7 font-semibold text-mauve-700 dark:text-mauve-400">About</div>
        <h1 class="font-display max-w-2xl text-5xl/12 font-medium tracking-tight text-balance sm:text-[3.5rem]/14 text-mauve-950 dark:text-white">Built to learn — and to be used.</h1>
        <div class="flex max-w-2xl flex-col gap-4 text-lg/8 text-mauve-700 dark:text-mauve-400">
          <p>
            Hi, I'm Emanuell. I built batze to teach myself Node.js and Nuxt — not with another throwaway tutorial,
            but by solving a real problem for a friend who runs an IT company. It's open source, so anyone can use it.
          </p>
        </div>
        <div class="flex items-center gap-4">
          <a href={demoUrl} class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full px-4 py-2 text-sm/7 font-medium bg-mauve-950 text-white hover:bg-mauve-800 dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">Try the demo</a>
          <a href={githubUrl} class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm/7 font-medium text-mauve-950 hover:bg-mauve-950/10 dark:text-white dark:hover:bg-white/10">
            <svg class="size-4" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" role="image"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            View on GitHub
          </a>
        </div>
      </div>
      <div class="flex flex-1 overflow-hidden rounded-xl outline -outline-offset-1 outline-black/5 *:object-cover dark:outline-white/5">
        <img src="https://placehold.co/1000x1200/ece7f1/8a7a90?text=me" alt="" width="1000" height="1200" class="not-dark:bg-white/75 dark:bg-black/75" />
      </div>
    </div>
  </section>

  <!-- Story -->
  <section id="story" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-6 px-6 text-base/8 text-mauve-700 md:max-w-3xl lg:px-10 dark:text-mauve-400 [&_strong]:font-semibold [&_strong]:text-mauve-950 dark:[&_strong]:text-white">
      <p>
        I learn best by building. So instead of grinding through another tutorial, I went looking for a real problem
        to solve with <strong>Node.js and Nuxt</strong>.
      </p>
      <p>
        I found it close to home: a good friend runs an <strong>IT company</strong> and loses hours to invoicing,
        projects, and client email. We've talked about it more times than I can count — so I built batze for him, and
        for anyone else stuck with the same admin.
      </p>
      <p>
        It's <strong>open source</strong> for the same reason I started it — to learn in the open. Read the code,
        poke holes in it, suggest improvements, or just self-host it and use it. That's the whole point.
      </p>
    </div>
  </section>

  <!-- Principles -->
  <section id="principles" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex max-w-2xl flex-col gap-6">
        <div class="flex flex-col gap-2">
          <div class="text-sm/7 font-semibold text-mauve-700 dark:text-mauve-400">What I care about</div>
          <h2 class="font-display text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">A few things I won't budge on.</h2>
        </div>
      </div>
      <div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2">
          {principles.map((p) => (
            <div class="flex flex-col gap-4">
              <div class="flex size-10 items-center justify-center rounded-lg bg-mauve-950/5 text-mauve-950 dark:bg-white/10 dark:text-white">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={p.icon} />
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-base/8 font-medium text-mauve-950 dark:text-white">{p.title}</h3>
                <p class="text-sm/7 text-mauve-700 dark:text-mauve-400">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Personal panel (dark accent) -->
  <section id="open" class="py-16">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex flex-col items-center gap-10 rounded-4xl bg-mauve-950 px-6 py-20 text-center sm:px-16 dark:ring-1 dark:ring-white/10">
        <p class="font-display mx-auto max-w-3xl text-2xl/9 font-medium tracking-tight text-balance text-white sm:text-3xl/10">
          batze is me learning in public — and building something genuinely useful while I'm at it. If that resonates, come build with me.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row">
          <a href={githubUrl} class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm/7 font-medium bg-mauve-300 text-mauve-950 hover:bg-mauve-200">
            <svg class="size-4" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" role="image"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            View on GitHub
          </a>
          <a href={docsUrl} class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm/7 font-medium text-white hover:bg-white/10">Read the docs</a>
        </div>
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
