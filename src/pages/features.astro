---
import Layout from "../layouts/Layout.astro";
import BentoCard from "../components/BentoCard.astro";
import CallToAction from "../components/CallToAction.astro";

const demoUrl = "#";

// Placeholder graphics until real app screenshots exist.
const g = (w: number, h: number) => `https://placehold.co/${w}x${h}/ece7f1/8a7a90?text=batze`;
const gd = (w: number, h: number) => `https://placehold.co/${w}x${h}/241c33/8f82a6?text=batze`;
---

<Layout
  title="batze — Features"
  description="Everything batze does: Swiss-ready invoicing, project & time tracking, and client email — in one open-source tool."
>
  <!-- Gradient hero -->
  <section class="py-16">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="relative isolate overflow-hidden rounded-4xl px-6 py-24 text-center sm:px-16">
        <div class="absolute inset-0 -z-10 rounded-4xl bg-linear-130 from-mauve-100 from-10% via-[#e0b9ea] via-65% to-[#b78ae6] ring-1 ring-black/5 ring-inset"></div>
        <h1 class="font-display mx-auto max-w-3xl text-4xl font-medium tracking-tighter text-balance text-mauve-950 sm:text-6xl">Everything batze does.</h1>
        <p class="mx-auto mt-6 max-w-xl text-lg/8 text-mauve-800">Invoicing, projects, and client email — in one open-source tool. Self-host it, or try the hosted demo.</p>
        <div class="mt-10 flex justify-center">
          <a href={demoUrl} class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full px-4 py-2 text-sm/7 font-medium bg-mauve-950 text-white hover:bg-mauve-800">Try the demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Light bento: the essentials -->
  <section id="essentials" class="py-16">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <h2 class="font-mono text-xs/5 font-semibold tracking-widest text-mauve-500 uppercase">Features</h2>
      <p class="mt-2 max-w-3xl font-display text-4xl font-medium tracking-tighter text-pretty text-mauve-950 sm:text-5xl">One tool for the whole job.</p>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">
        <BentoCard
          eyebrow="Invoicing"
          title="Get paid faster"
          description="Create a Swiss QR-bill in seconds, send it, and let batze track what's paid and gently chase what's overdue."
          graphic={g(900, 640)}
          fade={["bottom"]}
          class="max-lg:rounded-t-4xl lg:col-span-3 lg:rounded-tl-4xl"
        />
        <BentoCard
          eyebrow="Projects"
          title="Know where time goes"
          description="Group work into projects, log your hours, and turn billable time straight into a draft invoice."
          graphic={g(900, 640)}
          fade={["bottom"]}
          class="lg:col-span-3 lg:rounded-tr-4xl"
        />
        <BentoCard
          eyebrow="Email"
          title="Conversations in context"
          description="Read and reply to client email without leaving batze — filed against the right project."
          graphic={g(640, 640)}
          class="lg:col-span-2 lg:rounded-bl-4xl"
        />
        <BentoCard
          eyebrow="Time tracking"
          title="One-click timers"
          description="Track hours as you work, or fill them in later. Either way it lands on the invoice."
          graphic={g(640, 640)}
          class="lg:col-span-2"
        />
        <BentoCard
          eyebrow="Swiss-ready"
          title="QR-bills & VAT"
          description="Invoices that match the Swiss QR-bill standard, with VAT handled the way Switzerland expects."
          graphic={g(640, 640)}
          class="max-lg:rounded-b-4xl lg:col-span-2 lg:rounded-br-4xl"
        />
      </div>
    </div>
  </section>

  <!-- Dark bento: open by design -->
  <div class="mx-2 mt-2 rounded-4xl bg-mauve-950 py-32 dark:ring-1 dark:ring-white/10">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <h2 class="font-mono text-xs/5 font-semibold tracking-widest text-mauve-400 uppercase">Open by design</h2>
      <p class="mt-2 max-w-3xl font-display text-4xl font-medium tracking-tighter text-pretty text-white sm:text-5xl">Yours to run, end to end.</p>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">
        <BentoCard
          dark
          eyebrow="Self-hostable"
          title="Run it on your own server"
          description="batze is built to self-host. Spin it up with a single command and keep everything in-house."
          graphic={gd(1100, 640)}
          fade={["top"]}
          class="max-lg:rounded-t-4xl lg:col-span-4 lg:rounded-tl-4xl"
        />
        <BentoCard
          dark
          eyebrow="No lock-in"
          title="Open formats"
          description="Full CSV exports and open data — your invoices and clients are always yours to take."
          graphic={gd(640, 640)}
          class="lg:col-span-2 lg:rounded-tr-4xl"
        />
        <BentoCard
          dark
          eyebrow="Private"
          title="Your data stays put"
          description="When you self-host, nothing ever leaves your infrastructure. No third parties, no surprises."
          graphic={gd(640, 640)}
          class="lg:col-span-2 lg:rounded-bl-4xl"
        />
        <BentoCard
          dark
          eyebrow="Open source"
          title="Read every line"
          description="The whole codebase is public. Audit it, extend it, or contribute back — it's yours to shape."
          graphic={gd(1100, 640)}
          fade={["top"]}
          class="max-lg:rounded-b-4xl lg:col-span-4 lg:rounded-br-4xl"
        />
      </div>
    </div>
  </div>

  <CallToAction />
</Layout>
