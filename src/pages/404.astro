---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="The page you were looking for doesn't exist or has moved.">
  <section class="mx-auto flex min-h-[70vh] w-full max-w-2xl flex-col items-center justify-center px-6 py-24 text-center md:max-w-3xl lg:px-10">
    <p class="font-mono text-xs/5 font-semibold tracking-widest text-accent uppercase dark:text-accent-light">Error 404</p>
    <h1 class="font-display mt-4 text-5xl font-extrabold tracking-[-0.03em] text-balance text-white sm:text-7xl">Page not found</h1>
    <p class="mx-auto mt-6 max-w-md text-lg/8 text-mauve-400">
      The page you were looking for doesn't exist or has moved. Let's get you back on track.
    </p>
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/" class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full bg-accent px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium tracking-wider text-mauve-950 uppercase hover:bg-accent-light">Back home</a>
      <a href="/docs" class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium tracking-wider text-white uppercase inset-ring-1 inset-ring-white/15 hover:bg-white/5">Read the docs</a>
    </div>
  </section>
</Layout>
