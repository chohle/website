---
import Layout from "../layouts/Layout.astro";
import { langs, defaultLang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { localize } from "../i18n/utils";

// 404.astro is a single static page the host serves for *any* unmatched path,
// including localized ones like /de/foo. We can't know the language at build
// time, so we render the default locale server-side (good for no-JS + SEO) and
// swap in the right translation client-side based on the URL's lang prefix.
const i18n = Object.fromEntries(
  langs.map((lang) => {
    const t = useTranslations(lang);
    return [
      lang,
      {
        eyebrow: t("error.eyebrow"),
        title: t("error.title"),
        body: t("error.body"),
        backHome: t("error.backHome"),
        readDocs: t("cta.readDocs"),
        notFound: t("error.notFound"),
        homeHref: localize("/", lang),
        docsHref: localize("/docs", lang),
      },
    ];
  }),
);

const c = i18n[defaultLang];
---

<Layout title={c.title} description={c.body}>
  <section
    class="mx-auto flex min-h-[78vh] w-full max-w-3xl flex-col items-center justify-center px-6 py-24 text-center lg:px-10"
  >
    <p
      id="e404-eyebrow"
      data-reveal
      class="font-mono text-xs/5 font-semibold tracking-widest text-accent uppercase dark:text-accent-light"
    >
      {c.eyebrow}
    </p>

    <div data-reveal class="relative mt-6 flex items-end justify-center">
      <span
        class="font-display bg-gradient-to-b from-white via-mauve-200 to-mauve-600 bg-clip-text text-[7rem]/[0.85] font-extrabold tracking-[-0.05em] text-transparent select-none sm:text-[13rem]/[0.85]"
        aria-hidden="true">404</span
      >
      <span
        class="caret-blink ml-2 mb-3 inline-block h-[3.5rem] w-[0.55rem] bg-accent sm:mb-6 sm:h-[6rem] sm:w-[0.8rem]"
        aria-hidden="true"></span>
    </div>

    <h1
      id="e404-title"
      data-reveal
      class="font-display mt-8 text-3xl font-extrabold tracking-[-0.03em] text-balance text-white sm:text-4xl"
    >
      {c.title}
    </h1>

    <p
      id="e404-body"
      data-reveal
      class="mx-auto mt-5 max-w-md text-lg/8 text-mauve-400"
    >
      {c.body}
    </p>

    <p
      data-reveal
      class="mt-8 inline-flex max-w-full items-center gap-2 px-4 py-2 font-mono text-[0.78rem]/6 text-mauve-400 inset-ring-1 inset-ring-white/10"
    >
      <span class="shrink-0 text-accent">~</span>
      <span id="e404-path" class="truncate text-mauve-300"></span>
      <span id="e404-notfound" class="shrink-0 text-mauve-500">: {c.notFound}</span>
    </p>

    <div
      data-reveal
      class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >
      <a
        id="e404-home"
        href={c.homeHref}
        class="inline-flex shrink-0 items-center justify-center gap-1 bg-accent px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium tracking-wider text-mauve-950 uppercase hover:bg-accent-light"
        >{c.backHome}</a
      >
      <a
        id="e404-docs"
        href={c.docsHref}
        class="inline-flex shrink-0 items-center justify-center gap-1 px-6 py-2.5 font-mono text-[0.8rem]/7 font-medium tracking-wider text-white uppercase inset-ring-1 inset-ring-white/15 hover:bg-white/5"
        >{c.readDocs}</a
      >
    </div>
  </section>

  <script is:inline define:vars={{ i18n, langs }}>
    (function () {
      var seg = location.pathname.split("/")[1];
      var lang = langs.indexOf(seg) !== -1 ? seg : "en";
      var t = i18n[lang];

      // Always show the path the visitor actually hit (terminal motif).
      var pathEl = document.getElementById("e404-path");
      if (pathEl) pathEl.textContent = location.pathname;

      if (!t || lang === "en") return;

      document.documentElement.lang = lang;
      var set = function (id, val) {
        var el = document.getElementById(id);
        if (el) el.textContent = val;
      };
      set("e404-eyebrow", t.eyebrow);
      set("e404-title", t.title);
      set("e404-body", t.body);
      set("e404-notfound", ": " + t.notFound);

      var home = document.getElementById("e404-home");
      if (home) {
        home.textContent = t.backHome;
        home.setAttribute("href", t.homeHref);
      }
      var docs = document.getElementById("e404-docs");
      if (docs) {
        docs.textContent = t.readDocs;
        docs.setAttribute("href", t.docsHref);
      }
    })();
  </script>
</Layout>
