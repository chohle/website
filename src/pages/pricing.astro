---
import Layout from "../layouts/Layout.astro";
import CallToAction from "../components/CallToAction.astro";

const githubUrl = "#";
const docsUrl = "#";
const waitlistUrl = "#";

const selfHostedFeatures = [
  "Unlimited invoices, projects & clients",
  "Swiss QR-bills & VAT",
  "Client email inbox",
  "All exports & open data",
  "Community support",
  "MIT licensed — free forever",
];

const cloudIcon = `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z" />`;
const serverIcon = `<path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Z" />`;

const faqs = [
  {
    id: "faq-1",
    question: "Is batze really free?",
    answer: "Yes. Self-hosting is free and always will be — the whole thing is open source (MIT). No trial, no seat limits, no upsell.",
  },
  {
    id: "faq-2",
    question: "What's the catch with self-hosting?",
    answer: "You run batze on your own server and handle the occasional update. If that's not your thing, managed Cloud hosting is on the way.",
  },
  {
    id: "faq-3",
    question: "When is Cloud launching?",
    answer: "We're building it now. Join the waitlist and we'll email you the moment batze Cloud is ready — along with its pricing.",
  },
  {
    id: "faq-4",
    question: "Can I move between self-hosted and Cloud later?",
    answer: "Yes. Your data is yours and fully exportable, so you can migrate in either direction whenever it suits you.",
  },
];
---

<Layout
  title="batze — Pricing"
  description="batze is free and open source. Self-host it today; managed Cloud hosting is coming soon."
>
  <!-- Gradient hero -->
  <section class="py-16">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="relative isolate overflow-hidden rounded-4xl px-6 py-24 text-center sm:px-16">
        <div class="absolute inset-0 -z-10 rounded-4xl bg-linear-130 from-mauve-100 from-10% via-[#e0b9ea] via-65% to-[#b78ae6] ring-1 ring-black/5 ring-inset"></div>
        <h1 class="font-display mx-auto max-w-3xl text-4xl font-medium tracking-tighter text-balance text-mauve-950 sm:text-6xl">Honest, open pricing.</h1>
        <p class="mx-auto mt-6 max-w-xl text-lg/8 text-mauve-800">Self-host batze for free, forever. Prefer not to run a server? A fully managed Cloud is on the way.</p>
      </div>
    </div>
  </section>

  <!-- Cloud / Self-hosted selector -->
  <section id="plans" class="py-16">
    <div class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <el-tab-group>
        <el-tab-list class="mx-auto grid max-w-2xl grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- Self-hosted (available, selected by default) -->
          <button type="button" class="group flex flex-col items-center gap-3 rounded-2xl border border-mauve-950/10 bg-white p-6 text-center hover:border-mauve-950/20 aria-selected:border-mauve-950 aria-selected:ring-1 aria-selected:ring-mauve-950 dark:border-white/10 dark:bg-white/5 dark:hover:border-white/20 dark:aria-selected:border-white dark:aria-selected:ring-white">
            <div class="flex items-center gap-2 text-mauve-950 dark:text-white">
              <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={serverIcon} />
              <span class="font-display text-xl font-medium">Self-hosted</span>
            </div>
            <p class="text-sm/6 text-mauve-700 dark:text-mauve-400">Run it on your own infrastructure</p>
            <span class="text-sm/6 font-semibold text-mauve-950 dark:text-white">Free · available now</span>
          </button>
          <!-- Cloud (coming soon) -->
          <button type="button" class="group flex flex-col items-center gap-3 rounded-2xl border border-mauve-950/10 bg-white p-6 text-center hover:border-mauve-950/20 aria-selected:border-mauve-950 aria-selected:ring-1 aria-selected:ring-mauve-950 dark:border-white/10 dark:bg-white/5 dark:hover:border-white/20 dark:aria-selected:border-white dark:aria-selected:ring-white">
            <div class="flex items-center gap-2 text-mauve-950 dark:text-white">
              <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={cloudIcon} />
              <span class="font-display text-xl font-medium">Cloud</span>
            </div>
            <p class="text-sm/6 text-mauve-700 dark:text-mauve-400">Hosted by batze, always up to date</p>
            <span class="rounded-full bg-mauve-950/10 px-2 text-sm/6 font-medium text-mauve-700 dark:bg-white/10 dark:text-mauve-300">Coming soon</span>
          </button>
        </el-tab-list>

        <el-tab-panels class="mt-10">
          <!-- Self-hosted plan -->
          <div>
            <div class="mx-auto flex max-w-xl flex-col gap-6 rounded-3xl bg-mauve-950/2.5 p-8 ring-1 ring-mauve-950/5 sm:p-10 dark:bg-white/5 dark:ring-white/10">
              <div class="flex flex-col gap-3">
                <h2 class="text-2xl/8 tracking-tight text-mauve-950 dark:text-white">Self-hosted</h2>
                <p class="inline-flex items-baseline gap-2">
                  <span class="font-display text-5xl font-medium tracking-tight text-mauve-950 dark:text-white">Free</span>
                  <span class="text-sm/6 text-mauve-500">open source, forever</span>
                </p>
                <p class="text-sm/6 text-mauve-700 dark:text-mauve-400">Run batze on your own server. No seats, no limits, no expiry.</p>
              </div>
              <hr class="border-mauve-950/10 dark:border-white/10" />
              <ul class="grid grid-cols-1 gap-3 text-sm/6 text-mauve-700 sm:grid-cols-2 dark:text-mauve-400">
                {selfHostedFeatures.map((feature) => (
                  <li class="flex gap-3">
                    <svg class="h-lh shrink-0 stroke-mauve-950 dark:stroke-white" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1" role="image"><path d="M1.5 6.5L5.5 11.5L11.5 1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="flex flex-col gap-3 sm:flex-row">
                <a href={githubUrl} class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm/7 font-medium bg-mauve-950 text-white hover:bg-mauve-800 dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">
                  <svg class="size-4" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" role="image"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
                  View on GitHub
                </a>
                <a href={docsUrl} class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full px-4 py-2 text-sm/7 font-medium bg-mauve-950/10 text-mauve-950 hover:bg-mauve-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/20">Self-hosting guide</a>
              </div>
            </div>
          </div>

          <!-- Cloud (coming soon) -->
          <div>
            <div class="mx-auto flex max-w-xl flex-col items-center gap-6 rounded-3xl bg-mauve-950/2.5 p-8 text-center ring-1 ring-mauve-950/5 sm:p-10 dark:bg-white/5 dark:ring-white/10">
              <span class="rounded-full bg-mauve-950/10 px-3 py-0.5 text-xs/6 font-medium text-mauve-700 dark:bg-white/10 dark:text-mauve-300">Coming soon</span>
              <h2 class="font-display text-2xl/9 font-medium tracking-tight text-pretty text-mauve-950 dark:text-white">batze Cloud is on the way.</h2>
              <p class="text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">A fully managed batze — secure, always up to date, zero maintenance. We'll handle hosting, backups, and updates so you don't have to.</p>
              <a href={waitlistUrl} class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full px-4 py-2 text-sm/7 font-medium bg-mauve-950 text-white hover:bg-mauve-800 dark:bg-mauve-300 dark:text-mauve-950 dark:hover:bg-mauve-200">Join the waitlist</a>
              <p class="text-sm/6 text-mauve-500">Until then, batze is free to self-host.</p>
            </div>
          </div>
        </el-tab-panels>
      </el-tab-group>
    </div>
  </section>

  <!-- Pricing FAQ -->
  <section id="faqs" class="py-16">
    <div class="mx-auto grid w-full max-w-2xl grid-cols-1 gap-x-2 gap-y-8 px-6 md:max-w-3xl lg:max-w-7xl lg:grid-cols-2 lg:px-10">
      <div class="flex flex-col gap-6">
        <h2 class="font-display text-3xl/9 font-medium tracking-tight text-pretty text-mauve-950 sm:text-[2rem]/10 dark:text-white">No surprises.</h2>
        <div class="text-base/7 text-pretty text-mauve-700 dark:text-mauve-400">
          <p>The honest answers to what people ask before they commit.</p>
        </div>
      </div>
      <div class="divide-y divide-mauve-950/10 border-y border-mauve-950/10 dark:divide-white/10 dark:border-white/10">
        {faqs.map((faq) => (
          <div id={faq.id}>
            <button
              type="button"
              id={`${faq.id}-question`}
              command="--toggle"
              commandfor={`${faq.id}-answer`}
              class="flex w-full items-start justify-between gap-6 py-4 text-left text-base/7 text-mauve-950 dark:text-white"
            >
              {faq.question}
              <svg class="inline-block h-lh in-aria-expanded:hidden" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1" role="image"><path d="M6.5 0.5V12.5" stroke-linecap="round" stroke-linejoin="round" /><path d="M12.5049 6.49512L0.504883 6.49512" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <svg class="inline-block h-lh not-in-aria-expanded:hidden" width="13" height="1" viewBox="0 0 13 1" fill="none" stroke="currentColor" stroke-width="1" role="image"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M12.505.5h-12" /></svg>
            </button>
            <el-disclosure id={`${faq.id}-answer`} hidden class="-mt-2 flex flex-col gap-2 pr-12 pb-4 text-sm/7 text-mauve-700 dark:text-mauve-400">
              <p>{faq.answer}</p>
            </el-disclosure>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
