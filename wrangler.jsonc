{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    // Serve the prerendered 404.html (with a 404 status) for any unmatched path
    // instead of falling through to the Worker, which 500s on unknown routes.
    "not_found_handling": "404-page"
  }
}
